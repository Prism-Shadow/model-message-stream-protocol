---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import StreamPlayer from "../components/StreamPlayer.astro";
import { DISCORD_URL, REPO_URL, SITE_NAME, X_URL } from "../shared/site";

const themes = { light: "github-light", dark: "github-dark" } as const;

const python = `import asyncio
from mmsp import AutoLLMClient

async def main():
    client = AutoLLMClient(model="claude-opus-5")
    async for event in client.streaming_response_stateful(
        message={
            "role": "user",
            "content_items": [{"type": "text.done", "text": "Say 'Hello, World!'"}],
        },
        config={},
    ):
        print(event)

asyncio.run(main())`;

const typescript = `import { AutoLLMClient } from "@prismshadow/mmsp";

const client = new AutoLLMClient({ model: "claude-opus-5" });
for await (const event of client.streamingResponseStateful({
  message: {
    role: "user",
    content_items: [{ type: "text.done", text: "Say 'Hello, World!'" }],
  },
  config: {},
})) {
  console.log(event);
}`;

const grammar = `stream := delta_event* stop_event
items  := group*
group  := K.delta+ K.done
K      := text | thinking | tool_call
        | inline_data | inline_thinking | embedding`;

const goals = [
  {
    name: "Unified",
    text: "One UniConfig, one UniMessage, one UniEvent. Switching models is changing the model id, with no code written per provider.",
  },
  {
    name: "Streamed by one grammar",
    text: "Every stream is delta events closed by exactly one stop event, and every item is .delta fragments closed by its .done item. A consumer never guesses whether a response has finished.",
  },
  {
    name: "Precise",
    text: "Thinking signatures, phases and encrypted reasoning travel with each item as fidelity and go back to the provider unchanged, so interleaved thinking survives multi-step tool calls.",
  },
  {
    name: "Traceable",
    text: "Add a trace_id to the config and every turn is saved to disk, with a local viewer to read it. No database.",
  },
];

const models = [
  ["Gemini 3 to 3.8", "Official, Google Vertex AI", "gemini-3.8-flash", "Text, image, speech, embedding"],
  ["Claude 4.6 to 5", "Official, Amazon Bedrock, UModelVerse", "claude-opus-5", "Text"],
  ["GPT-5.4 to 6", "Official, OpenRouter, UModelVerse", "gpt-6-astra", "Text, embedding"],
  ["Kimi K2.5, K2.6, K3", "Official, OpenRouter, SiliconFlow", "kimi-k3", "Text"],
  ["DeepSeek V4", "Official, OpenRouter, SiliconFlow", "deepseek-v4-pro", "Text"],
  ["GLM-5.1 to 5.3", "Official, OpenRouter, SiliconFlow", "glm-5.3", "Text"],
  ["MiniMax-M3", "Official", "MiniMax-M3", "Text"],
  ["Qwen3.6", "OpenRouter, SiliconFlow, vLLM", "qwen/qwen3.6-35b-a3b", "Text, embedding"],
];

const section = "border-t border-gray-200 dark:border-gray-800";
const inner = "mx-auto max-w-7xl px-4 py-14 sm:px-6";
const heading = "text-2xl font-semibold tracking-tight";
const prose = "mt-4 max-w-3xl text-[15px] leading-7 text-gray-700 dark:text-gray-300";
const textLink =
  "text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-600 dark:text-brand-300 dark:decoration-brand-700";
---

<Base title={SITE_NAME} active="overview">
  <section>
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:py-20">
      <div>
        <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
          Model Message Stream Protocol
        </h1>
        <p class="mt-5 text-[17px] leading-8 text-gray-700 dark:text-gray-300">
          MMSP is one message format and one streaming grammar for every model provider. Write
          your agent once, and Claude, GPT, Gemini, DeepSeek, Kimi, GLM, MiniMax and Qwen all
          read and stream the same way, in Python and TypeScript.
        </p>

        <div class="code-group mt-7" data-labels="Python,TypeScript">
          <pre class="astro-code"><code>pip install mmsp</code></pre>
          <pre class="astro-code"><code>npm install @prismshadow/mmsp</code></pre>
        </div>

        <div class="mt-6 flex flex-wrap gap-2.5">
          <a
            href="/docs/quickstart/"
            class="rounded-lg bg-black px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200"
          >
            Read the quickstart
          </a>
          <a
            href="/docs/streaming/"
            class="rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-800 transition-colors hover:bg-gray-50 dark:border-gray-800 dark:text-gray-200 dark:hover:bg-gray-900"
          >
            See how a stream reads
          </a>
        </div>
      </div>

      <StreamPlayer />
    </div>
  </section>

  <section class={section} id="why">
    <div class={inner}>
      <h2 class={heading}>Why MMSP</h2>
      <p class={prose}>
        Model APIs have settled on the same building blocks: messages, thinking, tool calls,
        streaming. Every provider still encodes them its own way. Anthropic streams content
        blocks, OpenAI streams output items, Gemini streams steps, and Chat Completions streams
        chunks that name nothing. An agent written against one of them is rewritten for the next.
      </p>
      <p class={prose}>MMSP puts one shape in front of all of them. It is designed to be:</p>
      <dl class="mt-6 grid max-w-5xl gap-x-10 gap-y-6 sm:grid-cols-2">
        {
          goals.map((goal) => (
            <div class="border-l-2 border-brand-500 pl-4">
              <dt class="font-semibold">{goal.name}</dt>
              <dd class="mt-1 text-[15px] leading-7 text-gray-700 dark:text-gray-300">{goal.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class={section} id="grammar">
    <div class:list={[inner, "grid gap-10 lg:grid-cols-2"]}>
      <div>
        <h2 class={heading}>One grammar for every stream</h2>
        <p class={prose}>
          A stream is <code class="mono text-[0.9em]">delta</code> events, each carrying one content
          item, closed by exactly one <code class="mono text-[0.9em]">stop</code> event that carries
          the usage and the finish reason. Items arrive one at a time: fragments first, then the
          complete item.
        </p>
        <p class={prose}>
          The complete items, in order, are the assistant message. Read tool calls from{" "}
          <code class="mono text-[0.9em]">tool_call.done</code>, with the arguments already parsed,
          and treat the fragments as live progress.{" "}
          <a href="/docs/streaming/" class={textLink}>The streaming page</a> has every rule.
        </p>
      </div>
      <pre class="mono self-start overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 p-4 text-[13px] leading-6 dark:border-gray-800 dark:bg-gray-900">{grammar}</pre>
    </div>
  </section>

  <section class={section} id="models">
    <div class={inner}>
      <h2 class={heading}>Models it speaks to</h2>
      <p class={prose}>
        Each model is reached through its provider's own wire protocol, and four generic clients
        call any endpoint that serves Chat Completions, Responses, Anthropic Messages or OpenAI
        embeddings. <a href="/docs/models/" class={textLink}>Models and endpoints</a> lists the ids,
        keys and base URLs.
      </p>
      <div class="md-body mt-6">
        <table>
          <thead>
            <tr><th>Model</th><th>Served by</th><th>Example id</th><th>Output</th></tr>
          </thead>
          <tbody>
            {
              models.map(([model, vendor, id, output]) => (
                <tr>
                  <td>{model}</td>
                  <td>{vendor}</td>
                  <td><code>{id}</code></td>
                  <td>{output}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class={section} id="start">
    <div class:list={[inner, "grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"]}>
      <div>
        <h2 class={heading}>Get started</h2>
        <p class={prose}>
          Set the provider's API key in the environment, name a model, and iterate the stream. The
          stateful call keeps the conversation, thinking included, so the next turn only sends the
          new message.
        </p>
        <p class={prose}>
          <a href="/docs/quickstart/" class={textLink}>The quickstart</a> continues with a tool
          call and its result.
        </p>
      </div>
      <div class="code-group self-start">
        <Code code={python} lang="python" themes={themes} />
        <Code code={typescript} lang="typescript" themes={themes} />
      </div>
    </div>
  </section>

  <section class={section} id="contributing">
    <div class={inner}>
      <h2 class={heading}>Contributing</h2>
      <p class={prose}>
        MMSP is built in the open. A new model, a gateway that streams differently, a stream that
        breaks the grammar: <a href={`${REPO_URL}/issues`} class={textLink}>open an issue</a> or
        send a pull request. The repository carries the provider documentation snapshots and the
        workflow a client is built by.
      </p>
      <p class={prose}>
        Questions and releases are on <a href={DISCORD_URL} class={textLink}>Discord</a> and{" "}
        <a href={X_URL} class={textLink}>X</a>. MMSP is what{" "}
        <a href="https://penguin.ooo/" class={textLink}>PenguinHarness</a> talks to models with.
      </p>
    </div>
  </section>
</Base>

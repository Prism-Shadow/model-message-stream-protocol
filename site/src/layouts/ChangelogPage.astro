---
import Base from "./Base.astro";
import { STRINGS, type Locale } from "../shared/i18n";
import { REPO_URL } from "../shared/site";

interface Props {
  locale: Locale;
  // the repository's own changelog, compiled, so the page cannot fall behind it
  html: string;
}
const { locale, html } = Astro.props;
const s = STRINGS[locale].changelog;
const body = html
  // the title and the introduction are the page's, and the file's links are relative to the
  // repository
  .replace(/^.*?(?=<ul>)/s, "")
  .replaceAll('href="changelog/', `href="${REPO_URL}/blob/main/changelog/`);
---

<Base locale={locale} title={s.title} description={s.description} active="changelog">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <article class="w-full max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight">{s.title}</h1>
      <p class="mt-3 text-[15px] text-gray-600 dark:text-gray-400">{s.description}</p>
      <div class="md-body mt-6 text-[15px] text-gray-800 dark:text-gray-200" set:html={body} />
    </article>
  </div>
</Base>

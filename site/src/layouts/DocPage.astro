---
import type { MarkdownInstance } from "astro";
import Base from "./Base.astro";
import { STRINGS, localePath, type Locale } from "../shared/i18n";
import { ALL_DOCS, DOC_SECTIONS, REPO_URL, sectionOf, type DocLink } from "../shared/site";

type Doc = MarkdownInstance<{ description: string }>;

interface Props {
  locale: Locale;
  doc: DocLink;
  page: Doc;
}

const { locale, doc, page } = Astro.props;
const s = STRINGS[locale].docs;
const { Content } = page;
const section = sectionOf(doc.slug)!;
const index = ALL_DOCS.indexOf(doc);
const previous = ALL_DOCS[index - 1];
const next = ALL_DOCS[index + 1];
const headings = page.getHeadings().filter((heading) => heading.depth === 2 || heading.depth === 3);
const href = (slug: string) => localePath(locale, `/docs/${slug}/`);

const label = "text-xs font-semibold tracking-wide text-gray-400 uppercase dark:text-gray-500";
const entry = "-ml-px block border-l py-1 pl-3 transition-colors";
const entryOn = "border-brand-600 font-medium text-brand-700 dark:border-brand-400 dark:text-brand-300";
const entryOff =
  "border-transparent text-gray-600 hover:border-gray-400 hover:text-gray-900 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-gray-100";
const step =
  "group flex flex-col gap-1 rounded-xl border border-gray-200 p-4 transition-colors hover:border-gray-300 dark:border-gray-800 dark:hover:border-gray-700";
---

<Base
  locale={locale}
  title={doc.title[locale]}
  description={page.frontmatter.description}
  active={section.id}
  entry={doc.slug === ALL_DOCS[0].slug}
>
  <div class="mx-auto grid max-w-7xl lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_14rem]">
    <aside class="hidden border-r border-gray-200 lg:block dark:border-gray-800">
      <nav class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto px-6 py-8 text-sm" aria-label={s.title}>
        {
          DOC_SECTIONS.map((group) => (
            <div class="mb-6">
              <p class:list={[label, "mb-2"]}>{group.title[locale]}</p>
              <ul class="space-y-0.5 border-l border-gray-200 dark:border-gray-800">
                {group.docs.map((item) => (
                  <li>
                    <a
                      href={href(item.slug)}
                      class:list={[entry, item.slug === doc.slug ? entryOn : entryOff]}
                      aria-current={item.slug === doc.slug ? "page" : undefined}
                    >
                      {item.title[locale]}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <div class="min-w-0 px-4 py-10 sm:px-6 lg:px-10">
      <details class="mb-6 rounded-lg border border-gray-200 text-sm lg:hidden dark:border-gray-800">
        <summary class="cursor-pointer px-3 py-2 font-medium">{section.title[locale]}: {doc.title[locale]}</summary>
        <div class="border-t border-gray-200 px-3 py-2 dark:border-gray-800">
          {
            DOC_SECTIONS.map((group) => (
              <div class="py-1.5">
                <p class={label}>{group.title[locale]}</p>
                <ul class="mt-1">
                  {group.docs.map((item) => (
                    <li>
                      <a
                        href={href(item.slug)}
                        class:list={["block py-1", item.slug === doc.slug ? "font-medium text-brand-700 dark:text-brand-300" : "text-gray-600 dark:text-gray-400"]}
                      >
                        {item.title[locale]}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>

      <article class="w-full max-w-3xl">
        <header>
          <p class="text-xs font-semibold tracking-wide text-brand-700 uppercase dark:text-brand-300">
            {section.title[locale]}
          </p>
          <h1 class="mt-1.5 text-3xl font-semibold tracking-tight text-balance">{doc.title[locale]}</h1>
          <p class="mt-3 text-[15px] text-gray-600 dark:text-gray-400">{page.frontmatter.description}</p>
        </header>

        <div class="md-body mt-6 text-[15px] text-gray-800 dark:text-gray-200">
          <Content />
        </div>

        <div class="mt-10 grid gap-3 border-t border-gray-200 pt-6 sm:grid-cols-2 dark:border-gray-800">
          {
            previous ? (
              <a href={href(previous.slug)} class={step}>
                <span class="text-xs text-gray-500 dark:text-gray-400">{s.previous}</span>
                <span class="text-sm font-medium group-hover:text-brand-700 dark:group-hover:text-brand-300">
                  {previous.title[locale]}
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={href(next.slug)} class:list={[step, "sm:items-end sm:text-right"]}>
                <span class="text-xs text-gray-500 dark:text-gray-400">{s.next}</span>
                <span class="text-sm font-medium group-hover:text-brand-700 dark:group-hover:text-brand-300">
                  {next.title[locale]}
                </span>
              </a>
            )
          }
        </div>

        <p class="mt-6 text-xs text-gray-400 dark:text-gray-500">
          <a
            href={`${REPO_URL}/blob/main/site/src/docs/${doc.slug}.${locale}.md`}
            class="hover:text-gray-700 dark:hover:text-gray-300"
            target="_blank"
            rel="noreferrer"
          >
            {s.edit}
          </a>
        </p>
      </article>
    </div>

    <aside class="hidden xl:block">
      {
        headings.length > 0 && (
          <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto py-10 pr-6" aria-label={s.onThisPage}>
            <p class={label}>{s.onThisPage}</p>
            <ul class="mt-3 space-y-1 border-l border-gray-200 text-sm dark:border-gray-800">
              {headings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      "-ml-px block border-l border-transparent py-0.5 text-gray-600 transition-colors hover:border-gray-400 hover:text-gray-900 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-gray-100",
                      heading.depth === 3 ? "pl-6 text-[13px]" : "pl-3",
                    ]}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </aside>
  </div>
</Base>

---
// The docs and RFC search. A page mounts it three times: the sidebar's opener, the icon opener
// beside the section picker of a narrow screen, and the dialog, which searches the index of the
// page's language (/search/<locale>.json, built by src/pages/search/[locale].json.ts) fetched on
// first use. ⌘K / Ctrl K opens it from anywhere on the page.
import { STRINGS, type Locale } from "../shared/i18n";
import type { SearchArea } from "../shared/search";

interface Props {
  locale: Locale;
  // the page's area, whose results lead
  area: SearchArea;
  // an opener; without one, the dialog
  part?: "sidebar" | "icon";
}

const { locale, area, part } = Astro.props;
const s = STRINGS[locale].search;
const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
const kbd =
  "rounded border border-gray-200 bg-gray-50 px-1.5 py-0.5 text-[10px] leading-none text-gray-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400";
---

{
  part === "sidebar" && (
    <button
      type="button"
      class="mb-6 flex h-9 w-full items-center gap-2 rounded-lg border border-gray-200 px-3 text-left text-gray-500 transition-colors hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900 dark:border-gray-800 dark:text-gray-400 dark:hover:border-gray-700 dark:hover:bg-gray-900 dark:hover:text-gray-100"
      aria-haspopup="dialog"
      data-search-open
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" {...stroke} aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <span class="min-w-0 flex-1 truncate">{s.label}</span>
      <kbd class={kbd} data-search-shortcut>Ctrl K</kbd>
    </button>
  )
}
{
  part === "icon" && (
    <button
      type="button"
      class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-gray-200 text-gray-500 transition-colors hover:bg-gray-50 hover:text-gray-900 dark:border-gray-800 dark:text-gray-400 dark:hover:bg-gray-900 dark:hover:text-gray-100"
      aria-haspopup="dialog"
      aria-label={s.label}
      title={s.label}
      data-search-open
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" {...stroke} aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
    </button>
  )
}
{
  part === undefined && (
    <dialog class="search-dialog" aria-label={s.label} data-search-dialog data-index={`/search/${locale}.json`} data-area={area}>
      <div class="flex items-center gap-2 pr-2 pl-4">
        <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" {...stroke} aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          type="text"
          inputmode="search"
          enterkeyhint="search"
          autocomplete="off"
          spellcheck="false"
          placeholder={s.placeholder}
          aria-label={s.label}
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          class="h-12 min-w-0 flex-1 bg-transparent text-base text-gray-900 outline-none placeholder:text-gray-400 dark:text-gray-100 dark:placeholder:text-gray-500"
          data-search-input
        />
        <button type="button" class="search-close" aria-label={s.close} title={s.close} data-search-close>
          <svg viewBox="0 0 24 24" class="h-4 w-4" {...stroke} aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
      <div id="search-results" class="search-results" role="listbox" aria-label={s.label} data-search-results hidden></div>
      <p class="border-t border-gray-200 px-4 py-3 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400" data-search-empty hidden>
        {s.noMatch}
      </p>
      <p
        class="flex items-center gap-1.5 border-t border-gray-200 px-4 py-2 text-xs text-gray-500 max-sm:hidden dark:border-gray-800 dark:text-gray-400"
        data-search-keys
        hidden
      >
        <kbd class={kbd}>↑</kbd>
        <kbd class={kbd}>↓</kbd>
        <span>{s.keys.move}</span>
        <span aria-hidden="true">·</span>
        <kbd class={kbd}>↵</kbd>
        <span>{s.keys.open}</span>
        <span aria-hidden="true">·</span>
        <kbd class={kbd}>Esc</kbd>
        <span>{s.keys.close}</span>
      </p>
    </dialog>
  )
}

<style is:global>
  /* ---------- the search: a dialog in the frame of the catalog's kit dialog, held at 10vh from the
     top so the results grow downwards; the page holds still under it */
  .search-dialog {
    width: calc(100% - 2rem);
    max-width: 40rem;
    max-height: calc(100dvh - 10vh - 1rem);
    margin: 10vh auto auto;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--color-gray-200);
    border-radius: 0.75rem;
    background: var(--color-white);
    color: inherit;
    box-shadow: 0 24px 64px -16px rgb(0 0 0 / 0.25);
  }
  .search-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: search-in 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .dark .search-dialog {
    border-color: var(--color-gray-800);
    background: var(--color-gray-950);
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  .dark .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.65);
  }
  .search-dialog[open]::backdrop {
    animation: search-fade 150ms ease-out;
  }
  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
  }
  @keyframes search-fade {
    from {
      opacity: 0;
    }
  }
  /* the page keeps its scrollbar's room, so it does not shift sideways */
  html.search-open {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  .search-close {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--color-gray-500);
  }
  .search-close:hover {
    background: var(--color-gray-100);
    color: var(--color-gray-900);
  }
  .dark .search-close:hover {
    background: var(--color-gray-800);
    color: var(--color-gray-100);
  }
  .search-results {
    min-height: 0;
    overflow-y: auto;
    padding: 0.375rem;
    border-top: 1px solid var(--color-gray-200);
  }
  .dark .search-results {
    border-color: var(--color-gray-800);
  }
  .search-option {
    display: block;
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    outline: none;
  }
  .search-option[aria-selected="true"] {
    background: var(--color-gray-100);
  }
  .dark .search-option[aria-selected="true"] {
    background: var(--color-gray-900);
  }
  .search-option mark {
    background: transparent;
  }
</style>

<script>
  import {
    findSearchMatchRanges,
    prepareSearchRecords,
    searchRecords,
    type PreparedSearchRecord,
    type SearchArea,
    type SearchRecord,
    type SearchResult,
  } from "../shared/search";

  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>("[data-search-input]")!;
    const list = dialog.querySelector<HTMLElement>("[data-search-results]")!;
    const empty = dialog.querySelector<HTMLElement>("[data-search-empty]")!;
    const keys = dialog.querySelector<HTMLElement>("[data-search-keys]")!;
    const openers = [...document.querySelectorAll<HTMLButtonElement>("[data-search-open]")];
    const area = dialog.dataset.area as SearchArea;

    // the shortcut as the platform writes it
    if (/Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent)) {
      for (const label of document.querySelectorAll("[data-search-shortcut]")) label.textContent = "⌘ K";
    }

    // ---------- the index: fetched once, on the first hover or focus of an opener, or on opening;
    // a failed fetch is tried again on the next opening
    let records: PreparedSearchRecord[] | null = null;
    let loading: Promise<void> | undefined;
    const load = () =>
      (loading ??= fetch(dialog.dataset.index!)
        .then((response) =>
          response.ok ? (response.json() as Promise<SearchRecord[]>) : Promise.reject(response.status),
        )
        .then((data) => {
          records = prepareSearchRecords(data);
          render();
        })
        .catch(() => {
          loading = undefined;
        }));

    // ---------- the results: up to ten rows, the matches marked in the heading and the snippet
    let results: SearchResult[] = [];
    let active = 0;
    const marked = (text: string, query: string): Node[] => {
      const nodes: Node[] = [];
      let offset = 0;
      for (const range of findSearchMatchRanges(text, query)) {
        if (range.start > offset) nodes.push(document.createTextNode(text.slice(offset, range.start)));
        const mark = document.createElement("mark");
        mark.className = "text-brand-700 dark:text-brand-300";
        mark.textContent = text.slice(range.start, range.end);
        nodes.push(mark);
        offset = range.end;
      }
      if (offset < text.length) nodes.push(document.createTextNode(text.slice(offset)));
      return nodes;
    };
    const span = (className: string, children: (Node | string)[]) => {
      const element = document.createElement("span");
      element.className = className;
      element.append(...children);
      return element;
    };
    const options = () => [...list.querySelectorAll<HTMLAnchorElement>("[role='option']")];
    const select = (index: number) => {
      active = index;
      options().forEach((option, at) => option.setAttribute("aria-selected", String(at === index)));
      const option = options()[index];
      if (option) {
        input.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    };
    const render = () => {
      const query = input.value;
      const typed = query.trim() !== "";
      results = typed && records ? searchRecords(records, query, 10, area) : [];
      list.replaceChildren(
        ...results.map(({ record, snippet }, index) => {
          const option = document.createElement("a");
          option.id = `search-option-${index}`;
          option.href = record.href;
          option.className = "search-option";
          option.setAttribute("role", "option");
          const quiet = "text-xs text-gray-500 dark:text-gray-400";
          const head = span("flex items-baseline gap-2", [
            span(
              "min-w-0 truncate text-sm font-medium text-gray-900 dark:text-gray-100",
              marked(record.heading || record.title, query),
            ),
          ]);
          // a section's heading is named with its page, since many pages share headings (Summary, Rule)
          if (record.heading) head.append(span(`min-w-0 flex-1 truncate ${quiet}`, marked(record.title, query)));
          head.append(span(`ml-auto shrink-0 pl-2 ${quiet}`, [record.section]));
          option.append(head);
          if (snippet) option.append(span(`mt-0.5 line-clamp-2 block leading-5 ${quiet}`, marked(snippet, query)));
          return option;
        }),
      );
      list.hidden = results.length === 0;
      // "No match." only once the index is in, so a slow fetch does not say it first
      empty.hidden = !typed || !records || results.length > 0;
      keys.hidden = !typed;
      input.setAttribute("aria-expanded", String(results.length > 0));
      select(Math.min(active, results.length - 1));
    };
    input.addEventListener("input", () => {
      active = 0;
      render();
    });

    // ---------- open and close; closing gives the focus back to what opened the dialog
    let opener: HTMLElement | null = null;
    let leaving = false;
    const open = (from?: HTMLElement) => {
      if (dialog.open) {
        input.select();
        return;
      }
      opener = from ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
      leaving = false;
      document.documentElement.classList.add("search-open");
      dialog.showModal();
      input.focus();
      void load();
    };
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("search-open");
      input.value = "";
      active = 0;
      render();
      if (!leaving) opener?.focus({ preventScroll: true });
    });
    // following a result closes the dialog first, so an anchor on this page lands under no backdrop
    const follow = (option: HTMLAnchorElement) => {
      leaving = true;
      dialog.close();
      location.assign(option.href);
    };
    for (const button of openers) {
      button.addEventListener("click", () => open(button));
      button.addEventListener("pointerenter", () => void load());
      button.addEventListener("focus", () => void load());
    }
    dialog.querySelector("[data-search-close]")!.addEventListener("click", () => dialog.close());
    // a click on the backdrop lands on the dialog itself; one that began inside, as a selection of
    // the query dragged out, does not close it
    let pressedOutside = false;
    dialog.addEventListener("pointerdown", (event) => (pressedOutside = event.target === dialog));
    dialog.addEventListener("click", (event) => {
      if (pressedOutside && event.target === dialog) dialog.close();
    });
    list.addEventListener("pointermove", (event) => {
      const option = (event.target as Element).closest<HTMLAnchorElement>("[role='option']");
      const index = option ? options().indexOf(option) : -1;
      if (index >= 0 && index !== active) select(index);
    });
    list.addEventListener("click", (event) => {
      const option = (event.target as Element).closest<HTMLAnchorElement>("[role='option']");
      // a modified click opens the link elsewhere and leaves the dialog as it is
      if (!option || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      follow(option);
    });
    input.addEventListener("keydown", (event) => {
      if (event.isComposing) return;
      const count = results.length;
      if (event.key === "ArrowDown" && count > 0) {
        event.preventDefault();
        select((active + 1) % count);
      } else if (event.key === "ArrowUp" && count > 0) {
        event.preventDefault();
        select((active - 1 + count) % count);
      } else if (event.key === "Enter" && count > 0) {
        event.preventDefault();
        follow(options()[active]);
      }
    });
    addEventListener("keydown", (event) => {
      if (event.key.toLowerCase() === "k" && (event.ctrlKey || event.metaKey) && !event.altKey && !event.shiftKey) {
        event.preventDefault();
        open();
      }
    });
  }
</script>

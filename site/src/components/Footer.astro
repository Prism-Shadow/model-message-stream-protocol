---
import { STRINGS, type Locale } from "../shared/i18n";
import { DISCORD_URL, REPO_URL, X_URL } from "../shared/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = STRINGS[locale].footer;
const link = "transition-colors hover:text-gray-700 dark:hover:text-gray-300";
---

<footer class="border-t border-gray-200 dark:border-gray-800">
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-xs text-gray-400 sm:px-6 dark:text-gray-500"
  >
    <p>{s.license}</p>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <a href={REPO_URL} class={link} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`${REPO_URL}/blob/main/LICENSE`} class={link} target="_blank" rel="noreferrer">{s.licenseLink}</a>
      <a href={DISCORD_URL} class={link} target="_blank" rel="noreferrer">Discord</a>
      <a href={X_URL} class={link} target="_blank" rel="noreferrer">X</a>
      <a href="https://penguin.ooo/" class={link} target="_blank" rel="noreferrer">PenguinHarness</a>
    </div>
  </div>
</footer>

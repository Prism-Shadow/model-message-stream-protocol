---
// The vendors whose models MMSP reaches, as their marks. The row stands for the 1000+ models the
// official and compatible clients reach, so it ends on the count it does not draw, which opens
// the model catalog.
import VendorMark from "./VendorMark.astro";
import { MARKS } from "../shared/marks";

interface Props {
  more: string;
  href: string;
  class?: string;
}
const { more, href, class: className = "justify-center" } = Astro.props;
const VENDORS = ["openai", "anthropic", "gemini", "deepseek", "zai", "moonshot", "qwen", "openrouter"];
---

<div class:list={["flex flex-wrap items-center gap-x-4 gap-y-3", className]}>
  {
    VENDORS.map((id) => (
      <span title={MARKS[id].title} class="inline-flex items-center">
        <VendorMark id={id} class="h-7 w-7" inline />
      </span>
    ))
  }
  <a
    href={href}
    class="text-sm font-medium text-gray-500 tabular-nums underline decoration-gray-300 underline-offset-4 transition-colors hover:text-gray-900 hover:decoration-gray-500 dark:text-gray-400 dark:decoration-gray-600 dark:hover:text-gray-100 dark:hover:decoration-gray-400"
  >
    {more}
  </a>
</div>

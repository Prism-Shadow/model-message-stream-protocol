---
import Logo from "./Logo.astro";
import Menu from "./Menu.astro";
import { STRINGS, type Locale } from "../shared/i18n";
import { REPO_URL, SITE_NAME, formatStars, navLinks, repoStars } from "../shared/site";

interface Props {
  locale: Locale;
  // the entry of the top bar the page belongs to
  active: string;
}

const { locale, active } = Astro.props;
const s = STRINGS[locale];
const links = navLinks(locale);
const stars = await repoStars();
const link = "shrink-0 whitespace-nowrap rounded-md px-2 py-1.5 text-[13px] transition-colors";
const current =
  "bg-black text-white dark:bg-black dark:text-white dark:ring-1 dark:ring-gray-600";
const other =
  "text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100";
const button =
  "inline-flex h-9 min-w-9 items-center justify-center gap-1.5 rounded-lg border border-gray-200 bg-white px-2.5 text-xs font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-gray-950 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white";
// the language, theme and GitHub glyphs: Lucide (globe, sun, moon) and the GitHub mark
const icon = "h-[18px] w-[18px]";
---

<header
  class="sticky top-0 z-40 border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950"
>
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-2 px-4 sm:px-6">
    <a href={links[0].href} class="flex shrink-0 items-center gap-2">
      <Logo />
      <span class="text-[15px] font-semibold tracking-tight">{SITE_NAME}</span>
    </a>

    <nav class="ml-4 hidden items-center gap-0.5 md:flex" aria-label="Primary">
      {
        links.map((entry) => (
          <a
            href={entry.href}
            class:list={[link, entry.id === active ? current : other]}
            aria-current={entry.id === active ? "page" : undefined}
          >
            {entry.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <Menu
        id="lang"
        label={s.lang.label}
        current={s.lang[locale]}
        selected="system"
        options={[
          { value: "en", label: s.lang.en },
          { value: "zh", label: s.lang.zh },
          { value: "system", label: s.lang.system },
        ]}
      >
        <svg slot="icon" viewBox="0 0 24 24" class={icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
          <path d="M2 12h20"></path>
        </svg>
      </Menu>

      <Menu
        id="theme"
        label={s.theme.label}
        current={s.theme.system}
        selected="system"
        iconOnly
        options={[
          { value: "light", label: s.theme.light },
          { value: "dark", label: s.theme.dark },
          { value: "system", label: s.theme.system },
        ]}
      >
        <!-- the choice, as the page script shows it: the system's, light or dark -->
        <svg slot="icon" data-theme-icon="system" viewBox="0 0 24 24" class={icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2"></rect>
          <path d="M8 21h8M12 17v4"></path>
        </svg>
        <svg slot="icon" data-theme-icon="light" viewBox="0 0 24 24" class:list={[icon, "hidden"]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg slot="icon" data-theme-icon="dark" viewBox="0 0 24 24" class:list={[icon, "hidden"]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </Menu>

      <a href={REPO_URL} class={button} target="_blank" rel="noreferrer" title={s.nav.github}>
        <svg viewBox="0 0 16 16" class={icon} fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span class="sr-only">{s.nav.github}</span>
        <!-- the count holds its width from the first paint, so the buttons beside it never move -->
        <span class="min-w-[3ch] text-left tabular-nums" data-stars={REPO_URL}>
          <span data-stars-count>{stars === null ? "" : formatStars(stars)}</span>
        </span>
      </a>
    </div>
  </div>

  <nav class="flex gap-0.5 overflow-x-auto border-t border-gray-200 px-3 py-1.5 md:hidden dark:border-gray-800" aria-label="Primary">
    {
      links.map((entry) => (
        <a
          href={entry.href}
          class:list={[link, entry.id === active ? current : other]}
          aria-current={entry.id === active ? "page" : undefined}
        >
          {entry.label}
        </a>
      ))
    }
  </nav>
</header>

---
import Logo from "./Logo.astro";
import ModelLogos from "./ModelLogos.astro";
import StreamPlayer from "./StreamPlayer.astro";
import { localePath, type Locale } from "../shared/i18n";
import { REPO_URL, SITE_NAME } from "../shared/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const href = (path: string) => localePath(locale, path);

// what the skill button copies: a prompt that has a coding agent install both skills
const installPrompt = `Install the two skills in ${REPO_URL}/tree/main/skills, mmsp-python and mmsp-typescript, into my skills directory: ~/.claude/skills for Claude Code, .agents/skills for Codex. For Claude Code this does it: mkdir -p ~/.claude/skills && curl -fsSL ${REPO_URL}/archive/main.tar.gz | tar -xz -C ~/.claude/skills --strip-components=2 model-message-stream-protocol-main/skills. Then use them whenever you write code that calls a model through MMSP.`;

const COPY = {
  en: {
    slogan: "One protocol to reach and observe 1000+ models",
    subSlogan: "Less for developers to keep in mind, and no more tax on protocol adapters.",
    quickstart: "Quickstart",
    copyPrompt: "Install Agent Skill",
    copyHint: "Copies a prompt for Claude Code, Codex or any coding agent to install the MMSP skills",
    copied: "Copied",
    copyFailed: "Copy failed",
    stats: [
      ["Official and compatible clients", "1000+ models"],
      ["Python and TypeScript", "One API"],
      ["UniConfig, UniMessage, UniEvent", "Three types"],
      ["Apache 2.0", "Open source"],
    ],
    more: "+992 more",
  },
  zh: {
    slogan: "用同一种协议接入，观测 1000+ 种模型",
    subSlogan: "减轻开发者的心智负担，不再为协议适配交税",
    quickstart: "快速开始",
    copyPrompt: "Install Agent Skill",
    copyHint: "复制一段指令，交给 Claude Code、Codex 等编码助手安装 MMSP skill",
    copied: "已复制",
    copyFailed: "复制失败",
    stats: [
      ["官方与兼容客户端", "1000+ 模型"],
      ["Python 与 TypeScript", "同一套 API"],
      ["UniConfig、UniMessage、UniEvent", "三种类型"],
      ["Apache 2.0 许可", "完全开源"],
    ],
    more: "+992 种",
  },
}[locale];
---

<section class="hero relative overflow-hidden">
  <div class="relative mx-auto max-w-5xl px-4 pt-20 pb-14 text-center sm:px-6 sm:pt-24">
    <div class="rise flex items-center justify-center gap-3">
      <Logo class="h-14 w-14 rounded-[14px] shadow-sm" />
      <span class="text-4xl font-semibold tracking-tight">{SITE_NAME}</span>
    </div>

    <h1
      class="rise mx-auto mt-8 max-w-3xl text-4xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-[3.4rem]"
      style="animation-delay: 60ms"
    >
      {COPY.slogan}
    </h1>
    <p
      class="rise mx-auto mt-5 max-w-2xl text-lg text-balance text-gray-600 sm:text-xl dark:text-gray-400"
      style="animation-delay: 120ms"
    >
      {COPY.subSlogan}
    </p>

    <div class="rise mt-9 flex flex-wrap justify-center gap-3" style="animation-delay: 180ms">
      <a
        href={href("/docs/quickstart/")}
        class="inline-flex h-11 items-center gap-2 rounded-lg bg-black px-5 text-[15px] font-medium text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
        </svg>
        {COPY.quickstart}
      </a>
      <button
        type="button"
        title={COPY.copyHint}
        data-copy-prompt={installPrompt}
        data-copied={COPY.copied}
        data-failed={COPY.copyFailed}
        class="inline-flex h-11 items-center gap-2 rounded-lg border border-gray-200 bg-white px-5 text-[15px] font-medium text-gray-900 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:hover:bg-gray-900"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m4 17 6-6-6-6"></path>
          <path d="M12 19h8"></path>
        </svg>
        <span>{COPY.copyPrompt}</span>
      </button>
    </div>

    <dl class="rise mx-auto mt-14 grid max-w-4xl grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4" style="animation-delay: 240ms">
      {
        COPY.stats.map(([caption, value]) => (
          <div class="flex flex-col items-center gap-1">
            <dt class="order-2 text-[13px] text-balance text-gray-500 dark:text-gray-400">{caption}</dt>
            <dd class="order-1 text-2xl font-semibold tracking-tight">{value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="rise mt-12" style="animation-delay: 300ms">
      <ModelLogos more={COPY.more} />
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
  <StreamPlayer locale={locale} />
</section>

<style>
  /* a faint grid of dots behind the hero, fading out toward its edges */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgb(0 0 0 / 0.09) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 35%, black 20%, transparent 72%);
    pointer-events: none;
  }

  :global(.dark) .hero::before {
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.08) 1px, transparent 1.2px);
  }

  .rise {
    animation: rise 0.6s cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }
</style>

<script>
  // the prompt for a coding agent, copied from the hero
  const copy = document.querySelector<HTMLButtonElement>("[data-copy-prompt]");
  if (copy) {
    const label = copy.querySelector("span")!;
    const idle = label.textContent;
    let reset: number | undefined;
    const say = (text: string) => {
      label.textContent = text;
      window.clearTimeout(reset);
      reset = window.setTimeout(() => (label.textContent = idle), 2000);
    };
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copyPrompt!);
        say(copy.dataset.copied!);
      } catch {
        say(copy.dataset.failed!);
      }
    });
  }
</script>

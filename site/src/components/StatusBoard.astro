---
// The status page's body, modeled on status.openai.com: one framed card with the worst status of
// every channel the daily probe watches, when it last checked, Run a check now and the month's
// probe cost; then one block per channel, its TTFT and TPS beside the name and its last 90 days as
// bars, each of which opens a card with that day's result. The page is built with the probe's files
// (status-build.ts) and draws itself from them at once, then again from the status-data branch in
// the browser when the branch holds a newer run. The provider and vendor of each channel come from
// its base URL and model id, as the catalog names them. Run a check now opens the status workflow
// on GitHub, for a repository member to run; the page then follows that run and redraws itself
// from the commit it publishes. Marks point into the page's MarkSprite.
import { STRINGS, type Locale } from "../shared/i18n";
import { MARKS } from "../shared/marks";
import { STATUS_WORKFLOW_URL } from "../shared/status";
import { statusAtBuild } from "../shared/status-build";

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;
const s = STRINGS[locale];
// the trigger's note lives in the markup only, as the button's title and its description; the
// axis words under the bars are no longer drawn
const { triggerNote: _triggerNote, daysAgo: _daysAgo, today: _today, ...statusWords } = s.status;
const words = { ...statusWords, state: s.models.status, locale: s.htmlLang };
// the colour of each mark drawn in currentColor, for the marks the script draws
const tones = Object.fromEntries(Object.entries(MARKS).map(([id, mark]) => [id, mark.tone ?? ""]));
// the probe's files as of the build: the page draws from them before it fetches anything
const baked = await statusAtBuild();
---

<section class:list={["status-page", className]} data-status-board data-words={JSON.stringify(words)} data-tones={JSON.stringify(tones)}>
  <h1 class="sr-only">{s.status.title}</h1>
  <script type="application/json" data-status-baked set:html={JSON.stringify(baked).replaceAll("<", "\\u003c")} />
  <div class="status-card flex flex-wrap items-start justify-between gap-x-8 gap-y-4 rounded-xl border border-gray-200 p-5 sm:p-6 dark:border-gray-800">
    <div class="min-w-0">
      <p class="status-overall" data-status-overall>
        <span class="status-dot"></span>
        <span data-status-overall-text></span>
      </p>
      <p class="mt-1.5 text-[13px] text-gray-500 dark:text-gray-400" data-status-checked hidden>
        <a class="underline decoration-gray-300 underline-offset-4 hover:text-gray-900 dark:decoration-gray-600 dark:hover:text-gray-100"></a>
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <a
          href={STATUS_WORKFLOW_URL}
          target="_blank"
          rel="noreferrer"
          data-status-trigger
          title={s.status.triggerNote}
          aria-describedby="status-trigger-note"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-gray-200 px-2.5 text-xs font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-gray-950 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white"
        >
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="6 3 20 12 6 21 6 3"></polygon>
          </svg>
          <span>{s.status.trigger}</span>
        </a>
        <span id="status-trigger-note" class="sr-only">{s.status.triggerNote}</span>
        <span class="text-xs text-gray-500 dark:text-gray-400" aria-live="polite" data-status-trigger-progress hidden></span>
      </p>
    </div>
    <div class="sm:text-right" data-status-cost hidden>
      <p class="mono text-2xl font-semibold tabular-nums" data-status-cost-month></p>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-status-cost-label></p>
      <p class="mono mt-1 text-xs text-gray-400 tabular-nums dark:text-gray-500" data-status-cost-earlier></p>
    </div>
  </div>
  <div class="mt-2" data-status-blocks></div>
</section>

<script>
  import {
    STATUS_RANK,
    STATUS_RUN_URL,
    ago,
    formatMs,
    formatTps,
    formatUsd,
    lastDays,
    loadHistory,
    loadLatest,
    loadMonthly,
    statusCommitBase,
    statusHead,
    statusQuery,
    statusRuns,
    statusAnchor,
    statusLabel,
    type Day,
    type History,
    type Latest,
    type Monthly,
    type Status,
    type StatusWords,
    type TargetLatest,
  } from "../shared/status";
  import type { StatusAtBuild } from "../shared/status-build";
  import { providerOf, vendorOf } from "../shared/providers";

  interface Side {
    name: string;
    mark?: string;
  }
  type Words = {
    state: StatusWords;
    locale: string;
    overall: Record<Status | "allDown" | "none", string>;
    checked: string;
    month: string;
    run: string;
    runs: string;
    ttft: string;
    tps: string;
    tpsUnit: string;
    cost: string;
    uptime: string;
    uptimeShare: string;
    days: string;
    samples: string;
    waiting: string;
    running: string;
    updated: string;
    failed: string;
    waitedOut: string;
  };
  // a day as its card shows it, line by line, and as its bar's label reads it out
  interface DayFacts {
    date: string;
    status: Status | null;
    answered?: { ok: number; samples: number };
    metrics: { label?: string; value: string }[];
    error?: string;
  }

  const board = document.querySelector<HTMLElement>("[data-status-board]");
  if (board) {
    const words = JSON.parse(board.dataset.words!) as Words;
    const tones = JSON.parse(board.dataset.tones!) as Record<string, string>;
    const blocks = board.querySelector<HTMLElement>("[data-status-blocks]")!;
    const SVG = "http://www.w3.org/2000/svg";

    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
      const node = document.createElement(tag);
      node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const mark = (side: Side | null | undefined) => {
      const slot = element("span", "flex h-4 w-4 shrink-0 items-center justify-center");
      if (side?.mark) {
        const svg = document.createElementNS(SVG, "svg");
        svg.setAttribute("class", `h-4 w-4 ${tones[side.mark] ?? ""}`);
        svg.setAttribute("fill", "currentColor");
        svg.setAttribute("role", "img");
        svg.setAttribute("aria-label", side.name);
        const use = document.createElementNS(SVG, "use");
        use.setAttribute("href", `#mark-${side.mark}`);
        svg.append(use);
        slot.append(svg);
      }
      return slot;
    };
    const metric = (label: string, value: string, title?: string) => {
      const node = element("span", "status-metric");
      if (title) node.title = title;
      node.append(element("span", "status-metric-label", label), element("span", "mono", value));
      return node;
    };
    const monthName = (month: string) =>
      new Intl.DateTimeFormat(words.locale, { year: "numeric", month: "short", timeZone: "UTC" }).format(new Date(`${month}-01T00:00:00Z`));
    const runCount = (n: number) => (n === 1 ? words.run : words.runs).replace("{n}", String(n));

    // ---------- a day of a channel: what its card says and what its bar reads out
    const dayName = new Intl.DateTimeFormat(words.locale, { weekday: "short", year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
    const factsOf = (date: string, day: Day | undefined): DayFacts => {
      const facts: DayFacts = { date: dayName.format(new Date(`${date}T00:00:00Z`)), status: day?.status ?? null, metrics: [] };
      // a day without a key asked nothing, so there is nothing more to say
      if (!day || day.status === "nokey") return facts;
      if (typeof day.ok === "number" && typeof day.samples === "number") facts.answered = { ok: day.ok, samples: day.samples };
      if (day.ttft_ms !== null) facts.metrics.push({ label: words.ttft, value: formatMs(day.ttft_ms) });
      if (day.tps !== null) facts.metrics.push({ label: words.tps, value: formatTps(day.tps) });
      if (day.cost_usd !== null) facts.metrics.push({ value: formatUsd(day.cost_usd) });
      if (day.error && day.status !== "up") facts.error = day.error;
      return facts;
    };
    const answeredText = ({ ok, samples }: { ok: number; samples: number }) => words.samples.replace("{ok}", String(ok)).replace("{n}", String(samples));
    const spoken = (facts: DayFacts) =>
      [
        facts.date,
        facts.status ? words.state[facts.status] : words.state.none,
        ...(facts.answered ? [answeredText(facts.answered)] : []),
        ...facts.metrics.map(({ label, value }) => (label ? `${label} ${value}` : value)),
        ...(facts.error ? [facts.error] : []),
      ].join(", ");
    const facts = new WeakMap<HTMLElement, DayFacts>();
    const fillCard = (card: HTMLElement, day: DayFacts) => {
      const lines: HTMLElement[] = [element("p", "text-xs text-gray-500 dark:text-gray-400", day.date)];
      const state = element("p", "mt-1 flex items-center gap-2");
      state.append(statusLabel(day.status, words.state));
      if (day.answered) {
        const count = element("span", "mono text-xs tabular-nums text-gray-500 dark:text-gray-400", `${day.answered.ok}/${day.answered.samples}`);
        count.title = answeredText(day.answered);
        state.append(count);
      }
      lines.push(state);
      if (day.metrics.length) {
        const metrics = element("p", "mt-1 flex flex-wrap items-baseline gap-x-1.5 text-[13px] tabular-nums");
        day.metrics.forEach(({ label, value }, index) => {
          if (index) metrics.append(element("span", "text-gray-300 dark:text-gray-600", "·"));
          metrics.append(label ? metric(label, value) : element("span", "mono", value));
        });
        lines.push(metrics);
      }
      if (day.error) lines.push(element("p", "status-error mono", day.error));
      card.replaceChildren(...lines);
    };

    // ---------- the day card of a strip: for the bar under the pointer or with focus, and on a
    // phone for the bar tapped last. It floats over the page, so nothing moves when it opens.
    const showDay = (bar: HTMLElement) => {
      const strip = bar.closest<HTMLElement>(".status-strip")!;
      const card = strip.querySelector<HTMLElement>(".status-day-card")!;
      if (bar.dataset.active !== undefined && card.dataset.open !== undefined) return;
      strip.querySelector(".status-bar[data-active]")?.removeAttribute("data-active");
      fillCard(card, facts.get(bar)!);
      // centred on the bar, held inside the strip; a card wider than the strip (on a phone) starts
      // where the strip starts, and the page column still holds it
      const left = bar.offsetLeft + bar.offsetWidth / 2 - card.offsetWidth / 2;
      card.style.left = `${Math.max(0, Math.min(left, strip.clientWidth - card.offsetWidth))}px`;
      const above = bar.getBoundingClientRect().bottom + 4 + card.offsetHeight > innerHeight;
      card.style.top = above ? "auto" : "calc(2rem + 4px)";
      card.style.bottom = above ? "calc(2rem + 4px)" : "auto";
      bar.dataset.active = "";
      card.dataset.open = "";
    };
    const hideDay = (strip: HTMLElement) => {
      strip.querySelector(".status-bar[data-active]")?.removeAttribute("data-active");
      strip.querySelector(".status-day-card")?.removeAttribute("data-open");
    };
    const installDayCard = (strip: HTMLElement) => {
      const group = strip.querySelector<HTMLElement>(".status-bars")!;
      const bars = [...group.querySelectorAll<HTMLButtonElement>(".status-bar")];
      const barOf = (target: EventTarget | null) => (target instanceof Element ? target.closest<HTMLButtonElement>(".status-bar") : null);
      group.addEventListener("pointerover", (event) => {
        const bar = barOf(event.target);
        if (bar && event.pointerType !== "touch") showDay(bar);
      });
      // a finger leaves the strip as it lifts; its card stays until the next tap
      group.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "touch") hideDay(strip);
      });
      group.addEventListener("pointerdown", (event) => {
        const bar = barOf(event.target);
        if (!bar || event.pointerType !== "touch") return;
        if (bar.dataset.active === undefined) showDay(bar);
        else hideDay(strip);
      });
      group.addEventListener("focusin", (event) => {
        const bar = barOf(event.target);
        if (!bar) return;
        for (const other of bars) other.tabIndex = other === bar ? 0 : -1;
        showDay(bar);
      });
      group.addEventListener("focusout", (event) => {
        if (!(event.relatedTarget instanceof Node && group.contains(event.relatedTarget))) hideDay(strip);
      });
      group.addEventListener("keydown", (event) => {
        const bar = barOf(event.target);
        if (!bar) return;
        if (event.key === "Escape") {
          hideDay(strip);
          return;
        }
        const index = bars.indexOf(bar);
        const moves: Record<string, number> = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: bars.length - 1 };
        if (!(event.key in moves)) return;
        event.preventDefault();
        bars[Math.max(0, Math.min(moves[event.key], bars.length - 1))].focus();
      });
    };
    document.addEventListener(
      "pointerdown",
      (event) => {
        const path = event.composedPath();
        for (const card of blocks.querySelectorAll<HTMLElement>(".status-day-card[data-open]")) {
          if (!path.includes(card.parentElement!)) hideDay(card.parentElement!);
        }
      },
      true,
    );
    // a card stays where it was last shown; on a narrower window that place may lie past its edge
    let width = innerWidth;
    addEventListener("resize", () => {
      if (innerWidth === width) return;
      width = innerWidth;
      for (const card of blocks.querySelectorAll<HTMLElement>(".status-day-card")) {
        hideDay(card.parentElement!);
        card.style.left = "0px";
      }
    });

    // one bar per day, coloured by the day's status, and the share of probed days that were up
    const history = (days: Record<string, Day> | undefined, model: string) => {
      const row = element("div", "mt-3 flex items-start gap-3");
      const strip = element("div", "status-strip relative min-w-0 flex-1");
      const bars = element("div", "status-bars");
      bars.setAttribute("role", "group");
      bars.setAttribute("aria-label", `${words.days} · ${model}`);
      let probed = 0;
      let up = 0;
      let newest: HTMLButtonElement | undefined;
      for (const date of lastDays()) {
        const day = days?.[date];
        const bar = element("button", "status-bar");
        bar.type = "button";
        bar.dataset.status = day?.status ?? "none";
        bar.dataset.date = date;
        bar.tabIndex = -1;
        const dayFacts = factsOf(date, day);
        facts.set(bar, dayFacts);
        bar.setAttribute("aria-label", spoken(dayFacts));
        if (day) newest = bar;
        if (day && day.status !== "nokey") {
          probed += 1;
          if (day.status === "up") up += 1;
        }
        bars.append(bar);
      }
      // a Tab into the strip lands on the newest day the probe has an entry for
      (newest ?? (bars.lastElementChild as HTMLButtonElement)).tabIndex = 0;
      const card = element("div", "status-day-card");
      card.setAttribute("aria-hidden", "true");
      strip.append(bars, card);
      installDayCard(strip);
      const share = element("span", "w-24 shrink-0 text-right leading-8 whitespace-nowrap");
      share.title = words.uptime;
      const number = element("span", "mono text-[13px] tabular-nums text-gray-600 dark:text-gray-300", probed ? `${Number(((up / probed) * 100).toFixed(1))}%` : "—");
      if (probed) {
        const [before, after] = words.uptimeShare.split("{share}");
        if (before) share.append(element("span", "text-xs text-gray-500 dark:text-gray-400", before));
        share.append(number);
        if (after) share.append(element("span", "text-xs text-gray-500 dark:text-gray-400", after));
      } else share.append(number);
      row.append(strip, share);
      return row;
    };

    const block = (key: string, target: TargetLatest, days: Record<string, Day> | undefined, cost: string) => {
      const vendor = vendorOf(target.model);
      const provider = providerOf(target.base_url);
      const section = element("section", "status-block");
      section.id = statusAnchor(key);
      const head = element("div", "flex flex-wrap items-center justify-between gap-x-6 gap-y-2");
      // the dot and the names line up from block to block; a state other than up is said in words
      // after them
      const name = element("div", "flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1");
      if (target.checked_at) name.title = ago(target.checked_at, words.locale);
      const label = statusLabel(target.status, words.state);
      label.querySelector(".status-word")!.classList.add("sr-only");
      const model = element("span", "flex min-w-0 items-center gap-2");
      model.append(label, mark(vendor), element("span", "mono text-[14px] font-medium break-all", target.model));
      // on a phone the provider takes the next line, under the model id
      const served = element("span", "flex items-center gap-2 max-sm:basis-full max-sm:pl-10");
      served.append(element("span", "text-gray-300 max-sm:hidden dark:text-gray-600", "·"), mark(provider), element("span", "text-[14px] text-gray-600 dark:text-gray-400", provider.name));
      if (target.status !== "up") served.append(element("span", "status-state", words.state[target.status]));
      name.append(model, served);
      const metrics = element("div", "flex items-center gap-x-5 text-[13px] tabular-nums");
      metrics.append(
        metric(words.ttft, formatMs(target.ttft_ms)),
        metric(words.tps, formatTps(target.tps), words.tpsUnit),
        metric(words.cost, cost, words.month),
      );
      head.append(name, metrics);
      section.append(head, history(days, target.model));
      if (target.error && target.status !== "up") section.append(element("p", "status-error mono", target.error));
      return section;
    };

    // the board as one set of files draws it: the build's at once, the branch's when it holds a
    // newer run, and again when a check run by hand lands
    let shown: Latest | null = null;
    let scrolled = false;
    const render = (latest: Latest | null, historyData: History | null, monthly: Monthly | null) => {
      shown = latest;
      const overall = board.querySelector<HTMLElement>("[data-status-overall]")!;
      const overallText = board.querySelector<HTMLElement>("[data-status-overall-text]")!;
      const targets = Object.entries(latest?.targets ?? {});
      // the worst status of the probed channels names the page; a channel without a key is a
      // matter of configuration, not an outage
      const probed = targets.filter(([, target]) => target.status !== "nokey");
      let state: Status | "allDown" | "none" = "none";
      if (targets.length && !probed.length) state = "nokey";
      else if (probed.length) {
        const worst = probed.reduce<Status>((acc, [, target]) => (STATUS_RANK[target.status] > STATUS_RANK[acc] ? target.status : acc), "up");
        state = worst === "down" && probed.every(([, target]) => target.status === "down") ? "allDown" : worst;
      }
      overall.dataset.status = state === "allDown" ? "down" : state;
      overallText.textContent = words.overall[state];
      if (!latest) return;

      const stamps = targets.map(([, target]) => target.checked_at).filter((stamp): stamp is string => Boolean(stamp)).sort();
      const checked = board.querySelector<HTMLElement>("[data-status-checked]")!;
      const run = checked.querySelector("a")!;
      run.textContent = words.checked.replace("{ago}", ago(stamps.at(-1) ?? latest.generated_at, words.locale));
      run.href = STATUS_RUN_URL + latest.run_id;
      checked.hidden = false;

      const thisMonth = new Date().toISOString().slice(0, 7);
      const month = monthly?.months[thisMonth];
      if (monthly) {
        board.querySelector("[data-status-cost-month]")!.textContent = formatUsd(month?.total_usd ?? 0);
        board.querySelector("[data-status-cost-label]")!.textContent = [words.month, month ? runCount(month.runs) : ""].filter(Boolean).join(" · ");
        const earlier = Object.keys(monthly.months)
          .filter((name) => name < thisMonth)
          .sort()
          .reverse();
        const earlierLine = board.querySelector<HTMLElement>("[data-status-cost-earlier]")!;
        earlierLine.textContent = earlier.slice(0, 3).map((name) => `${monthName(name)} ${formatUsd(monthly.months[name].total_usd)}`).join(" · ");
        earlierLine.title = earlier.map((name) => `${monthName(name)} ${formatUsd(monthly.months[name].total_usd)} · ${runCount(monthly.months[name].runs)}`).join("\n");
        board.querySelector<HTMLElement>("[data-status-cost]")!.hidden = false;
      }

      blocks.replaceChildren(
        ...targets.map(([key, target]) => block(key, target, historyData?.targets[key], target.status === "nokey" ? "—" : formatUsd(month?.targets[key]))),
      );
      // a link from the catalog names a block that only exists now
      if (scrolled) return;
      scrolled = true;
      const wanted = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (wanted) wanted.scrollIntoView();
    };
    const baked = JSON.parse(board.querySelector("[data-status-baked]")!.textContent!) as StatusAtBuild;
    render(baked.latest, baked.history, baked.monthly);
    // a ?status= override on this machine always wins over the build
    void Promise.all([loadLatest(), loadHistory(), loadMonthly()]).then(([latest, historyData, monthly]) => {
      if (latest && (latest.run_id !== shown?.run_id || statusQuery())) render(latest, historyData, monthly);
    });

    // ---------- a check run by hand: the button opens the workflow on GitHub; from the click on,
    // the page follows the workflow's newest run once a minute, for up to 30 minutes, and draws the
    // commit it publishes. A tick the runs API does not answer watches the branch head instead.
    const trigger = board.querySelector<HTMLAnchorElement>("[data-status-trigger]")!;
    const note = board.querySelector<HTMLElement>("[data-status-trigger-progress]")!;
    const POLL_MS = 60_000;
    const WAIT_MS = 30 * 60_000;
    // a run is stamped by GitHub's clock, which may be behind this one
    const SKEW_MS = 2 * 60_000;
    let timer: number | undefined;
    let startedAt = 0;
    let lastCheck = 0;
    let said = "";
    const say = (text: string, href?: string) => {
      if (said === `${text} ${href}`) return;
      said = `${text} ${href}`;
      note.hidden = false;
      if (!href) {
        note.textContent = text;
        return;
      }
      const link = element("a", "underline decoration-gray-300 underline-offset-4 hover:text-gray-900 dark:decoration-gray-600 dark:hover:text-gray-100", text);
      link.href = href;
      link.target = "_blank";
      link.rel = "noreferrer";
      note.replaceChildren(link);
    };
    const stop = (text: string, href?: string) => {
      window.clearInterval(timer);
      timer = undefined;
      say(text, href);
    };
    // a commit's files, drawn when they hold a result the page does not show
    const refresh = async (sha: string) => {
      const base = statusCommitBase(sha);
      const [latest, historyData, monthly] = await Promise.all([loadLatest(base), loadHistory(base), loadMonthly(base)]);
      if (!latest || (latest.run_id === shown?.run_id && latest.generated_at === shown?.generated_at)) return false;
      render(latest, historyData, monthly);
      return true;
    };
    const check = async (first = false) => {
      lastCheck = Date.now();
      if (first) {
        // a page opened before the latest run catches up at once
        const head = await statusHead();
        if (head) await refresh(head);
        return;
      }
      const runs = await statusRuns();
      if (!runs) {
        const head = await statusHead();
        if (head && (await refresh(head))) return stop(words.updated);
      } else {
        const run = runs.find((candidate) => Date.parse(candidate.created_at) >= startedAt - SKEW_MS);
        if (run?.status === "completed") {
          if (run.conclusion !== "success") return stop(words.failed, run.html_url);
          const head = await statusHead();
          if (head) await refresh(head);
          if (shown?.run_id === String(run.id)) return stop(words.updated);
        } else if (run) say(words.running, run.html_url);
      }
      if (Date.now() - startedAt > WAIT_MS) stop(words.waitedOut);
    };
    // the link opens GitHub in a new tab; clicking again starts the wait over
    trigger.addEventListener("click", () => {
      startedAt = Date.now();
      say(words.waiting);
      window.clearInterval(timer);
      timer = window.setInterval(() => void check(), POLL_MS);
      void check(true);
    });
    document.addEventListener("visibilitychange", () => {
      if (timer && !document.hidden && Date.now() - lastCheck > 30_000) void check();
    });
  }
</script>


---
// The status page's body, modeled on status.openai.com: one card whose head band takes the colour
// of the worst status of every channel the daily probe watches, its icon and its words; under the
// band the last probe, linked to its run, and the next one status.yml is expected to start, each a
// local time with its relative time beside it, then Run a check now, and last a footnote with the
// month's probe cost and run count. Then a pager that
// moves the window of days shown back and forth, a switch of its length (7, 30 or 90, kept for the
// next visit), and one block per channel: a head line with its state icon, vendor, model, provider,
// TTFT, TPS and uptime over the window, and under it one bar per day, each of which opens a
// card with that day's result. The page is built with the probe's files (status-build.ts), the last
// 180 days of history, and draws itself from them at once, then again from the status-data branch
// in the browser when the branch holds a newer run; older days come from the branch's 365-day
// history.json and, paged back further, its yearly archives. The provider and vendor of
// each channel come from its base URL and model id, as the catalog names them. Run a check now
// opens the status workflow on GitHub, for a repository member to run; the page then follows that
// run and redraws itself from the commit it publishes. Marks point into the page's MarkSprite.
import { STRINGS, type Locale } from "../shared/i18n";
import { MARKS, PLACEHOLDER, initialOf } from "../shared/marks";
import { STATUS_RUN_URL, STATUS_WORKFLOW_URL, dailySchedule, todayUtc, windowDays } from "../shared/status";
import { statusAtBuild } from "../shared/status-build";

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;
const s = STRINGS[locale];
// the trigger's note lives in the markup only, as the button's title and its description; the
// axis words under the bars are no longer drawn, and a strip is named by its window's dates
const { triggerNote: _triggerNote, ...statusWords } = s.status;
const words = { ...statusWords, state: s.models.status, locale: s.htmlLang };
// the colour of each mark drawn in currentColor, for the marks the script draws
const tones = Object.fromEntries(Object.entries(MARKS).map(([id, mark]) => [id, mark.tone ?? ""]));
// the probe's files as of the build: the page draws from them before it fetches anything. Of the
// 365 days of history.json it carries the last BAKED_DAYS, the default window and one 90-day page
// back; an older page reads the branch. That is ~60 KB today and ~620 KB raw (~60 KB gzipped) at 30
// channels, when history.json itself should be cut to 180 days and the yearly archives serve the rest.
const BAKED_DAYS = 180;
const baked = await statusAtBuild();
const bakedFrom = windowDays(todayUtc(), BAKED_DAYS)[0];
const bakedHistory = baked.history && {
  ...baked.history,
  days: BAKED_DAYS,
  targets: Object.fromEntries(
    Object.entries(baked.history.targets).map(([key, days]) => [key, Object.fromEntries(Object.entries(days).filter(([date]) => date >= bakedFrom))]),
  ),
};
// the days a strip can show, and the one it shows first; the script restores the visitor's last
// choice
const RANGES = [7, 30, 90] as const;
const DEFAULT_RANGE = 90;
// when the probe runs next comes from the workflow itself, so the page never drifts from it
const workflow = Object.values(import.meta.glob<string>("../../../.github/workflows/status.yml", { query: "?raw", import: "default", eager: true }))[0];
const schedule = workflow ? dailySchedule(workflow) : null;
const TIME_LABEL = "text-[11px] font-medium tracking-wider text-gray-500 uppercase dark:text-gray-400";
const TIME_VALUE = "mt-1 text-[15px] leading-6 font-semibold tabular-nums";
---

<section
  class:list={["status-page", className]}
  data-status-board
  data-words={JSON.stringify(words)}
  data-tones={JSON.stringify(tones)}
  data-schedule={schedule ? JSON.stringify(schedule) : undefined}
>
  <h1 class="sr-only">{s.status.title}</h1>
  <script type="application/json" data-status-baked set:html={JSON.stringify({ ...baked, history: bakedHistory }).replaceAll("<", "\\u003c")} />
  <div class="status-card overflow-hidden rounded-xl border" data-status-overall>
    <div class="status-card-head flex items-center gap-2.5 px-5 py-3.5 sm:px-6">
      <span class="flex h-5 w-5 items-center justify-center" data-status-overall-icon></span>
      <p class="min-h-7 text-xl font-semibold tracking-tight" data-status-overall-text></p>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4 px-5 py-4 sm:px-6">
      <dl class="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-[auto_auto] sm:justify-start" data-status-times>
        <div class="min-w-0" data-status-checked>
          <dt class={TIME_LABEL}>{s.status.lastProbe}</dt>
          <dd class={TIME_VALUE}>
            <a
              href={baked.latest ? STATUS_RUN_URL + baked.latest.run_id : undefined}
              target="_blank"
              rel="noreferrer"
              class="underline decoration-gray-300 underline-offset-4 hover:decoration-gray-500 dark:decoration-gray-600 dark:hover:decoration-gray-400 [&:not([href])]:no-underline"
              data-status-checked-at
            >—</a><span class="font-normal text-gray-500 dark:text-gray-400" data-status-checked-ago></span>
          </dd>
        </div>
        <div class="min-w-0" data-status-next>
          <dt class={TIME_LABEL}>{s.status.nextProbe}</dt>
          <dd class={TIME_VALUE}>
            <span data-status-next-at>—</span><span class="font-normal text-gray-500 dark:text-gray-400" data-status-next-in></span>
          </dd>
        </div>
      </dl>
      {/* the button and the cost keep to the right of the times, and on a phone under them */}
      <div class="flex w-full flex-col items-start gap-1.5 sm:ml-auto sm:w-auto sm:items-end">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 sm:flex-row-reverse">
          <a
            href={STATUS_WORKFLOW_URL}
            target="_blank"
            rel="noreferrer"
            data-status-trigger
            title={s.status.triggerNote}
            aria-describedby="status-trigger-note"
            class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-gray-200 px-2.5 text-xs font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-gray-950 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white"
          >
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="6 3 20 12 6 21 6 3"></polygon>
            </svg>
            <span>{s.status.trigger}</span>
          </a>
          <span id="status-trigger-note" class="sr-only">{s.status.triggerNote}</span>
          <span class="text-xs text-gray-500 dark:text-gray-400" aria-live="polite" data-status-trigger-progress hidden></span>
        </p>
        {/* shown from the first paint when the build has the month's file, so filling it in moves nothing */}
        <p class="min-h-4 text-xs text-gray-400 tabular-nums dark:text-gray-500" data-status-cost hidden={!(baked.latest && baked.monthly)}></p>
      </div>
    </div>
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <div class="flex items-center gap-1 text-[13px] text-gray-500 dark:text-gray-400" data-status-pager>
      <button type="button" class="status-page-button" data-status-earlier aria-label={s.status.earlier} title={s.status.earlier}>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <span class="min-w-[9ch] text-center tabular-nums" aria-live="polite" data-status-window></span>
      <button type="button" class="status-page-button" data-status-later aria-label={s.status.later} title={s.status.later} disabled>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
    <div class="segmented" role="radiogroup" aria-label={s.status.rangeLabel} data-status-range style={`--n: ${RANGES.length}; --i: ${RANGES.indexOf(DEFAULT_RANGE)}`}>
      <span class="segmented-thumb" aria-hidden="true"></span>
      {
        RANGES.map((days) => (
          <button type="button" role="radio" aria-checked={days === DEFAULT_RANGE ? "true" : "false"} data-value={days}>
            {s.status.range[days]}
          </button>
        ))
      }
    </div>
  </div>
  <div class="mt-2" data-status-blocks></div>
</section>

<script>
  import {
    HISTORY_DAYS,
    STATUS_RANK,
    STATUS_RUN_URL,
    ago,
    formatMs,
    formatTps,
    formatUsd,
    loadHistory,
    loadHistoryYear,
    loadLatest,
    loadMonthly,
    nextRun,
    statusCommitBase,
    statusHead,
    statusQuery,
    statusRuns,
    statusAnchor,
    statusIcon,
    statusLabel,
    todayUtc,
    windowDays,
    withCurrentKeys,
    type DailySchedule,
    type Day,
    type History,
    type HistoryYear,
    type Latest,
    type Monthly,
    type Status,
    type StatusWords,
    type TargetLatest,
  } from "../shared/status";
  import type { StatusAtBuild } from "../shared/status-build";
  import { providerOf, vendorOf } from "../shared/providers";

  interface Side {
    name: string;
    mark?: string;
  }
  type Words = {
    state: StatusWords;
    locale: string;
    overall: Record<Status | "allDown" | "none", string>;
    cost: string;
    run: string;
    runs: string;
    ttft: string;
    tps: string;
    tpsUnit: string;
    uptime: string;
    uptimeShare: string;
    samples: string;
    waiting: string;
    running: string;
    updated: string;
    failed: string;
    waitedOut: string;
  };
  // a day as its card shows it, line by line, and as its bar's label reads it out
  interface DayFacts {
    date: string;
    status: Status | null;
    answered?: { ok: number; samples: number };
    metrics: { label?: string; value: string }[];
    error?: string;
  }

  const board = document.querySelector<HTMLElement>("[data-status-board]");
  if (board) {
    const words = JSON.parse(board.dataset.words!) as Words;
    const tones = JSON.parse(board.dataset.tones!) as Record<string, string>;
    const blocks = board.querySelector<HTMLElement>("[data-status-blocks]")!;
    const SVG = "http://www.w3.org/2000/svg";

    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
      const node = document.createElement(tag);
      node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const mark = (side: Side | null | undefined) => {
      const slot = element("span", "flex h-4 w-4 shrink-0 items-center justify-center");
      if (side?.mark) {
        const svg = document.createElementNS(SVG, "svg");
        svg.setAttribute("class", `h-4 w-4 ${tones[side.mark] ?? ""}`);
        svg.setAttribute("fill", "currentColor");
        svg.setAttribute("role", "img");
        svg.setAttribute("aria-label", side.name);
        const use = document.createElementNS(SVG, "use");
        use.setAttribute("href", `#mark-${side.mark}`);
        svg.append(use);
        slot.append(svg);
      } else if (side) {
        const placeholder = element("span", `${PLACEHOLDER} h-4 w-4`, initialOf(side.name));
        placeholder.setAttribute("role", "img");
        placeholder.setAttribute("aria-label", side.name);
        slot.append(placeholder);
      }
      return slot;
    };
    const metric = (label: string, value: string, title?: string) => {
      const node = element("span", "status-metric");
      if (title) node.title = title;
      node.append(element("span", "status-metric-label", label), element("span", "mono", value));
      return node;
    };
    const monthName = (month: string) =>
      new Intl.DateTimeFormat(words.locale, { year: "numeric", month: "short", timeZone: "UTC" }).format(new Date(`${month}-01T00:00:00Z`));
    const runCount = (n: number) => (n === 1 ? words.run : words.runs).replace("{n}", String(n));

    // ---------- a day of a channel: what its card says and what its bar reads out
    const dayName = new Intl.DateTimeFormat(words.locale, { weekday: "short", year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
    const factsOf = (date: string, day: Day | undefined): DayFacts => {
      const facts: DayFacts = { date: dayName.format(new Date(`${date}T00:00:00Z`)), status: day?.status ?? null, metrics: [] };
      // a day without a key asked nothing, so there is nothing more to say
      if (!day || day.status === "nokey") return facts;
      if (typeof day.ok === "number" && typeof day.samples === "number") facts.answered = { ok: day.ok, samples: day.samples };
      if (day.ttft_ms !== null) facts.metrics.push({ label: words.ttft, value: formatMs(day.ttft_ms) });
      if (day.tps !== null) facts.metrics.push({ label: words.tps, value: formatTps(day.tps) });
      if (day.cost_usd !== null) facts.metrics.push({ value: formatUsd(day.cost_usd) });
      if (day.error && day.status !== "up") facts.error = day.error;
      return facts;
    };
    const answeredText = ({ ok, samples }: { ok: number; samples: number }) => words.samples.replace("{ok}", String(ok)).replace("{n}", String(samples));
    const spoken = (facts: DayFacts) =>
      [
        facts.date,
        facts.status ? words.state[facts.status] : words.state.none,
        ...(facts.answered ? [answeredText(facts.answered)] : []),
        ...facts.metrics.map(({ label, value }) => (label ? `${label} ${value}` : value)),
        ...(facts.error ? [facts.error] : []),
      ].join(", ");
    const facts = new WeakMap<HTMLElement, DayFacts>();
    const fillCard = (card: HTMLElement, day: DayFacts) => {
      const lines: HTMLElement[] = [element("p", "text-xs text-gray-500 dark:text-gray-400", day.date)];
      const state = element("p", "mt-1 flex items-center gap-2");
      state.append(statusLabel(day.status, words.state));
      if (day.answered) {
        const count = element("span", "mono text-xs tabular-nums text-gray-500 dark:text-gray-400", `${day.answered.ok}/${day.answered.samples}`);
        count.title = answeredText(day.answered);
        state.append(count);
      }
      lines.push(state);
      if (day.metrics.length) {
        const metrics = element("p", "mt-1 flex flex-wrap items-baseline gap-x-1.5 text-[13px] tabular-nums");
        day.metrics.forEach(({ label, value }, index) => {
          if (index) metrics.append(element("span", "text-gray-300 dark:text-gray-600", "·"));
          metrics.append(label ? metric(label, value) : element("span", "mono", value));
        });
        lines.push(metrics);
      }
      if (day.error) lines.push(element("p", "status-error mono", day.error));
      card.replaceChildren(...lines);
    };

    // ---------- the day card of a strip: for the bar under the pointer or with focus, and on a
    // phone for the bar tapped last. It floats over the page, so nothing moves when it opens.
    const showDay = (bar: HTMLElement) => {
      const strip = bar.closest<HTMLElement>(".status-strip")!;
      const card = strip.querySelector<HTMLElement>(".status-day-card")!;
      if (bar.dataset.active !== undefined && card.dataset.open !== undefined) return;
      strip.querySelector(".status-bar[data-active]")?.removeAttribute("data-active");
      fillCard(card, facts.get(bar)!);
      // centred on the bar, held inside the strip; a card wider than the strip (on a phone) starts
      // where the strip starts, and the page column still holds it
      const left = bar.offsetLeft + bar.offsetWidth / 2 - card.offsetWidth / 2;
      card.style.left = `${Math.max(0, Math.min(left, strip.clientWidth - card.offsetWidth))}px`;
      const above = bar.getBoundingClientRect().bottom + 4 + card.offsetHeight > innerHeight;
      card.style.top = above ? "auto" : "calc(1rem + 4px)";
      card.style.bottom = above ? "calc(1rem + 4px)" : "auto";
      bar.dataset.active = "";
      card.dataset.open = "";
    };
    const hideDay = (strip: HTMLElement) => {
      strip.querySelector(".status-bar[data-active]")?.removeAttribute("data-active");
      strip.querySelector(".status-day-card")?.removeAttribute("data-open");
    };
    const installDayCard = (strip: HTMLElement) => {
      const group = strip.querySelector<HTMLElement>(".status-bars")!;
      const bars = [...group.querySelectorAll<HTMLButtonElement>(".status-bar")];
      const barOf = (target: EventTarget | null) => (target instanceof Element ? target.closest<HTMLButtonElement>(".status-bar") : null);
      group.addEventListener("pointerover", (event) => {
        const bar = barOf(event.target);
        if (bar && event.pointerType !== "touch") showDay(bar);
      });
      // a finger leaves the strip as it lifts; its card stays until the next tap
      group.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "touch") hideDay(strip);
      });
      group.addEventListener("pointerdown", (event) => {
        const bar = barOf(event.target);
        if (!bar || event.pointerType !== "touch") return;
        if (bar.dataset.active === undefined) showDay(bar);
        else hideDay(strip);
      });
      group.addEventListener("focusin", (event) => {
        const bar = barOf(event.target);
        if (!bar) return;
        for (const other of bars) other.tabIndex = other === bar ? 0 : -1;
        showDay(bar);
      });
      group.addEventListener("focusout", (event) => {
        if (!(event.relatedTarget instanceof Node && group.contains(event.relatedTarget))) hideDay(strip);
      });
      group.addEventListener("keydown", (event) => {
        const bar = barOf(event.target);
        if (!bar) return;
        if (event.key === "Escape") {
          hideDay(strip);
          return;
        }
        const index = bars.indexOf(bar);
        const moves: Record<string, number> = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: bars.length - 1 };
        if (!(event.key in moves)) return;
        event.preventDefault();
        bars[Math.max(0, Math.min(moves[event.key], bars.length - 1))].focus();
      });
    };
    document.addEventListener(
      "pointerdown",
      (event) => {
        const path = event.composedPath();
        for (const card of blocks.querySelectorAll<HTMLElement>(".status-day-card[data-open]")) {
          if (!path.includes(card.parentElement!)) hideDay(card.parentElement!);
        }
      },
      true,
    );
    // a card stays where it was last shown; on a narrower window that place may lie past its edge
    let width = innerWidth;
    addEventListener("resize", () => {
      if (innerWidth === width) return;
      width = innerWidth;
      for (const card of blocks.querySelectorAll<HTMLElement>(".status-day-card")) {
        hideDay(card.parentElement!);
        card.style.left = "0px";
      }
    });

    // one bar per day of the window shown, coloured by the day's status, and the share of the probed
    // days in it that were up, which the block's head line shows
    const history = (days: Record<string, Day> | undefined, model: string, dates: string[], dated: string) => {
      const strip = element("div", "status-strip relative mt-2");
      const bars = element("div", "status-bars");
      bars.setAttribute("role", "group");
      bars.setAttribute("aria-label", `${dated} · ${model}`);
      let probed = 0;
      let up = 0;
      let newest: HTMLButtonElement | undefined;
      for (const date of dates) {
        const day = days?.[date];
        const bar = element("button", "status-bar");
        bar.type = "button";
        bar.dataset.status = day?.status ?? "none";
        bar.dataset.date = date;
        bar.tabIndex = -1;
        const dayFacts = factsOf(date, day);
        facts.set(bar, dayFacts);
        bar.setAttribute("aria-label", spoken(dayFacts));
        if (day) newest = bar;
        if (day && day.status !== "nokey") {
          probed += 1;
          if (day.status === "up") up += 1;
        }
        bars.append(bar);
      }
      // a Tab into the strip lands on the newest day the probe has an entry for
      (newest ?? (bars.lastElementChild as HTMLButtonElement)).tabIndex = 0;
      const card = element("div", "status-day-card");
      card.setAttribute("aria-hidden", "true");
      strip.append(bars, card);
      installDayCard(strip);
      // "100% uptime" / "可用率 100%": the number, and the word on whichever side the language puts it
      const uptime = element("span", "status-metric");
      uptime.title = words.uptime;
      const [before, after] = words.uptimeShare.split("{share}").map((part) => part.trim());
      if (before) uptime.append(element("span", "status-metric-label", before));
      uptime.append(element("span", "mono", probed ? `${Number(((up / probed) * 100).toFixed(1))}%` : "—"));
      if (after) uptime.append(element("span", "status-metric-label", after));
      return { row: strip, uptime };
    };

    const block = (key: string, target: TargetLatest, days: Record<string, Day> | undefined, dates: string[], dated: string) => {
      const vendor = vendorOf(target.model);
      const provider = providerOf(target.base_url);
      const section = element("section", "status-block");
      section.id = statusAnchor(key);
      // one line above the strip: the channel on the left, its numbers on the right; on a phone the
      // numbers take the next line
      const head = element("div", "flex flex-wrap items-center justify-between gap-x-6 gap-y-1");
      // the icon and the names line up from block to block; a state other than up is said in words
      // after them
      const name = element("div", "flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1");
      if (target.checked_at) name.title = ago(target.checked_at, words.locale);
      const label = statusLabel(target.status, words.state);
      label.title = words.state[target.status];
      label.querySelector(".status-word")!.classList.add("sr-only");
      const model = element("span", "flex min-w-0 items-center gap-2");
      model.append(label, mark(vendor), element("span", "mono text-[14px] font-medium break-all", target.model));
      const served = element("span", "flex items-center gap-2");
      served.append(element("span", "text-gray-300 dark:text-gray-600", "·"), mark(provider), element("span", "text-[14px] text-gray-600 dark:text-gray-400", provider.name));
      if (target.status !== "up") served.append(element("span", "status-state", words.state[target.status]));
      name.append(model, served);
      const { row, uptime } = history(days, target.model, dates, dated);
      // on a phone the gaps narrow so that the numbers keep one line
      const metrics = element("div", "flex flex-wrap items-baseline gap-x-1.5 gap-y-1 text-[13px] tabular-nums max-sm:basis-full max-sm:gap-x-1");
      [metric(words.ttft, formatMs(target.ttft_ms)), metric(words.tps, formatTps(target.tps), words.tpsUnit), uptime].forEach((item, index) => {
        if (index) metrics.append(element("span", "text-gray-300 dark:text-gray-600", "·"));
        metrics.append(item);
      });
      head.append(name, metrics);
      section.append(head, row);
      if (target.error && target.status !== "up") section.append(element("p", "status-error mono", target.error));
      return section;
    };

    // ---------- the window of days on screen: `range` days (7, 30 or 90, kept for the next visit)
    // that end on `end`, which starts at today; ‹ and › move it by one range, as status.openai.com
    // pages its quarters. A change redraws the blocks from the days the page holds.
    const RANGE_KEY = "mmsp-site.status-range";
    const ranges = board.querySelector<HTMLElement>("[data-status-range]")!;
    const rangeButtons = [...ranges.querySelectorAll<HTMLButtonElement>("button")];
    const pager = board.querySelector<HTMLElement>("[data-status-pager]")!;
    const earlierButton = pager.querySelector<HTMLButtonElement>("[data-status-earlier]")!;
    const laterButton = pager.querySelector<HTMLButtonElement>("[data-status-later]")!;
    const windowLabel = pager.querySelector<HTMLElement>("[data-status-window]")!;
    let range = Number(rangeButtons.find((button) => button.getAttribute("aria-checked") === "true")!.dataset.value);
    let end = todayUtc();
    const addDays = (date: string, count: number) => new Date(Date.parse(`${date}T00:00:00Z`) + count * 86_400_000).toISOString().slice(0, 10);
    const startOf = (last: string) => addDays(last, 1 - range);
    const applyRange = (days: number) => {
      range = days;
      rangeButtons.forEach((button, index) => {
        const chosen = Number(button.dataset.value) === days;
        button.setAttribute("aria-checked", String(chosen));
        if (chosen) ranges.style.setProperty("--i", String(index));
      });
    };
    try {
      const remembered = Number(localStorage.getItem(RANGE_KEY));
      if (rangeButtons.some((button) => Number(button.dataset.value) === remembered)) applyRange(remembered);
    } catch {}
    // "Jul 26 – Oct 23" / "7月26日 – 10月23日", with the year when the window ends before this year or
    // spans two. English takes the browser's range format, which says once what both ends share;
    // Chinese writes both ends whole, since its range format falls back to "7/26 – 10/23"
    const windowText = (start: string, last: string) => {
      const day: Intl.DateTimeFormatOptions = { month: "short", day: "numeric", timeZone: "UTC" };
      const dated: Intl.DateTimeFormatOptions = { ...day, year: "numeric" };
      const [from, to] = [new Date(`${start}T00:00:00Z`), new Date(`${last}T00:00:00Z`)];
      const earlierYear = last.slice(0, 4) !== todayUtc().slice(0, 4);
      if (!words.locale.startsWith("zh")) return new Intl.DateTimeFormat(words.locale, earlierYear ? dated : day).formatRange(from, to);
      const twoYears = start.slice(0, 4) !== last.slice(0, 4);
      const format = (options: Intl.DateTimeFormatOptions, date: Date) => new Intl.DateTimeFormat(words.locale, options).format(date);
      return `${format(twoYears || earlierYear ? dated : day, from)} – ${format(twoYears ? dated : day, to)}`;
    };

    // ---------- the days the page holds: the rolling history.json (the build's last 180 days, the
    // branch's 365 once read) over the yearly archives read while paging back
    let shown: Latest | null = null;
    let rolling: History | null = null;
    // the branch's rolling file has answered, or failed to
    let rollingAsked = false;
    // the archives asked for, by year; null when one did not come
    const archives = new Map<string, HistoryYear | null>();
    let held: History | null = null;
    // the oldest day any of those files has an entry for
    let oldest: string | undefined;
    const hold = () => {
      const targets: Record<string, Record<string, Day>> = {};
      for (const archive of archives.values()) {
        for (const [key, days] of Object.entries(archive?.targets ?? {})) Object.assign((targets[key] ??= {}), days);
      }
      for (const [key, days] of Object.entries(rolling?.targets ?? {})) Object.assign((targets[key] ??= {}), days);
      held = rolling || archives.size ? { days: rolling?.days ?? HISTORY_DAYS, targets } : null;
      oldest = Object.values(targets)
        .flatMap((days) => Object.keys(days))
        .sort()[0];
    };

    let scrolled = false;
    const thisMonth = () => new Date().toISOString().slice(0, 7);
    const renderBlocks = (latest: Latest | null, historyData: History | null, count: number, last: string) => {
      const dates = windowDays(last, count);
      const dated = windowText(dates[0], last);
      blocks.replaceChildren(
        ...Object.entries(latest?.targets ?? {}).map(([key, target]) => block(key, target, historyData?.targets[key], dates, dated)),
      );
    };
    // ‹ while a day the page holds lies before the window, or a file that may hold older days has
    // not been asked for; › until the window ends today. A button that turns disabled under the
    // keyboard hands the focus to the other.
    const updatePager = () => {
      const start = startOf(end);
      windowLabel.textContent = windowText(start, end);
      const focused = document.activeElement;
      const olderYear = addDays(oldest ?? start, -1).slice(0, 4);
      earlierButton.disabled = !shown || !((oldest !== undefined && start > oldest) || !rollingAsked || !archives.has(olderYear));
      laterButton.disabled = end >= todayUtc();
      if (focused === earlierButton && earlierButton.disabled && !laterButton.disabled) laterButton.focus();
      if (focused === laterButton && laterButton.disabled && !earlierButton.disabled) earlierButton.focus();
    };
    const drawWindow = () => {
      renderBlocks(shown, held, range, end);
      updatePager();
    };
    for (const button of rangeButtons) {
      button.addEventListener("click", () => {
        const days = Number(button.dataset.value);
        if (days === range) return;
        try {
          localStorage.setItem(RANGE_KEY, String(days));
        } catch {}
        applyRange(days);
        drawWindow();
      });
    }
    let paging = false;
    earlierButton.addEventListener("click", async () => {
      if (paging || earlierButton.disabled) return;
      const start = startOf(end);
      const last = addDays(end, -range);
      const first = startOf(last);
      if (oldest === undefined || first < oldest) {
        // the window would reach past the days held: read the whole rolling file where the page
        // holds the build's part of it, then the archive of each year the window touches
        paging = true;
        pager.setAttribute("aria-busy", "true");
        if (!rollingAsked) await revalidated;
        if (oldest === undefined || first < oldest) {
          const years = [...new Set([first.slice(0, 4), last.slice(0, 4)])].filter((year) => !archives.has(year));
          const found = await Promise.all(years.map((year) => loadHistoryYear(year)));
          years.forEach((year, index) => archives.set(year, found[index]));
          hold();
        }
        paging = false;
        pager.removeAttribute("aria-busy");
        // nothing older than the window on screen: it stays, and ‹ turns grey
        if (oldest === undefined || oldest >= start) return updatePager();
      }
      end = last;
      drawWindow();
    });
    laterButton.addEventListener("click", () => {
      if (laterButton.disabled) return;
      const today = todayUtc();
      const last = addDays(end, range);
      end = last > today ? today : last;
      drawWindow();
    });

    // ---------- the last probe and the next one by the workflow's schedule: each a local time, with
    // its relative time beside it said again every minute and the full date in its tooltip. The next
    // is only expected: GitHub may start a scheduled run late, so for a while after the hour the
    // next time named is tomorrow's even before today's run has landed.
    const checkedRun = board.querySelector<HTMLAnchorElement>("[data-status-checked-at]")!;
    const checkedAgo = board.querySelector<HTMLElement>("[data-status-checked-ago]")!;
    const nextAt = board.querySelector<HTMLElement>("[data-status-next-at]")!;
    const nextIn = board.querySelector<HTMLElement>("[data-status-next-in]")!;
    const schedule = board.dataset.schedule ? (JSON.parse(board.dataset.schedule) as DailySchedule) : null;
    const localTime = new Intl.DateTimeFormat(words.locale, { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
    const fullTime = new Intl.DateTimeFormat(words.locale, { dateStyle: "full", timeStyle: "long", hourCycle: "h23" });
    let checkedAt: string | undefined;
    const tick = () => {
      if (!checkedAt) return;
      const checked = new Date(checkedAt);
      checkedRun.textContent = localTime.format(checked);
      checkedRun.title = fullTime.format(checked);
      checkedAgo.textContent = ` · ${ago(checkedAt, words.locale)}`;
      if (!schedule) return;
      const next = nextRun(schedule);
      nextAt.textContent = localTime.format(next);
      nextAt.title = fullTime.format(next);
      nextIn.textContent = ` · ${ago(next.toISOString(), words.locale)}`;
    };
    window.setInterval(tick, 60_000);

    // the board as one set of files draws it: the build's at once, the branch's when it holds a
    // newer run, and again when a check run by hand lands
    const render =(latest: Latest | null, historyData: History | null, monthly: Monthly | null) => {
      shown = latest;
      rolling = historyData;
      hold();
      const overall = board.querySelector<HTMLElement>("[data-status-overall]")!;
      const overallText = board.querySelector<HTMLElement>("[data-status-overall-text]")!;
      const targets = Object.entries(latest?.targets ?? {});
      // the worst status of the probed channels names the page; a channel without a key is a
      // matter of configuration, not an outage
      const probed = targets.filter(([, target]) => target.status !== "nokey");
      let state: Status | "allDown" | "none" = "none";
      if (targets.length && !probed.length) state = "nokey";
      else if (probed.length) {
        const worst = probed.reduce<Status>((acc, [, target]) => (STATUS_RANK[target.status] > STATUS_RANK[acc] ? target.status : acc), "up");
        state = worst === "down" && probed.every(([, target]) => target.status === "down") ? "allDown" : worst;
      }
      // the card's band and icon take the state; a page without a key or without data is grey
      const shape = state === "allDown" ? "down" : state;
      overall.dataset.status = shape;
      board.querySelector("[data-status-overall-icon]")!.replaceChildren(statusIcon(shape, "h-5 w-5"));
      overallText.textContent = words.overall[state];
      if (!latest) return updatePager();

      const stamps = targets.map(([, target]) => target.checked_at).filter((stamp): stamp is string => Boolean(stamp)).sort();
      checkedAt = stamps.at(-1) ?? latest.generated_at;
      checkedRun.href = STATUS_RUN_URL + latest.run_id;
      tick();

      if (monthly) {
        const current = thisMonth();
        const month = monthly.months[current];
        const costLine = board.querySelector<HTMLElement>("[data-status-cost]")!;
        costLine.textContent = [`${words.cost} ${formatUsd(month?.total_usd ?? 0)}`, month ? runCount(month.runs) : ""].filter(Boolean).join(" · ");
        costLine.title = Object.keys(monthly.months)
          .filter((name) => name < current)
          .sort()
          .reverse()
          .map((name) => `${monthName(name)} ${formatUsd(monthly.months[name].total_usd)} · ${runCount(monthly.months[name].runs)}`)
          .join("\n");
        costLine.hidden = false;
      }

      drawWindow();
      // a link from the catalog names a block that only exists now
      if (scrolled) return;
      scrolled = true;
      const wanted = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (wanted) wanted.scrollIntoView();
    };
    const baked = JSON.parse(board.querySelector("[data-status-baked]")!.textContent!) as StatusAtBuild;
    // the build copies the branch's files as they are, so a build made before the probe's first run
    // with the new keys carries the old ones
    render(withCurrentKeys(baked.latest), withCurrentKeys(baked.history), withCurrentKeys(baked.monthly));
    // a ?status= override on this machine always wins over the build; the same run's history.json
    // holds 365 days to the build's 180, for paging further back
    const revalidated = Promise.all([loadLatest(), loadHistory(), loadMonthly()]).then(([latest, historyData, monthly]) => {
      rollingAsked = true;
      if (latest && (latest.run_id !== shown?.run_id || statusQuery())) return render(latest, historyData, monthly);
      if (latest && historyData && latest.run_id === shown?.run_id) rolling = historyData;
      hold();
      updatePager();
    });

    // ---------- a check run by hand: the button opens the workflow on GitHub; from the click on,
    // the page follows the workflow's newest run once a minute, for up to 30 minutes, and draws the
    // commit it publishes. A tick the runs API does not answer watches the branch head instead.
    const trigger = board.querySelector<HTMLAnchorElement>("[data-status-trigger]")!;
    const note = board.querySelector<HTMLElement>("[data-status-trigger-progress]")!;
    const POLL_MS = 60_000;
    const WAIT_MS = 30 * 60_000;
    // a run is stamped by GitHub's clock, which may be behind this one
    const SKEW_MS = 2 * 60_000;
    let timer: number | undefined;
    let startedAt = 0;
    let lastCheck = 0;
    let said = "";
    const say = (text: string, href?: string) => {
      if (said === `${text} ${href}`) return;
      said = `${text} ${href}`;
      note.hidden = false;
      if (!href) {
        note.textContent = text;
        return;
      }
      const link = element("a", "underline decoration-gray-300 underline-offset-4 hover:text-gray-900 dark:decoration-gray-600 dark:hover:text-gray-100", text);
      link.href = href;
      link.target = "_blank";
      link.rel = "noreferrer";
      note.replaceChildren(link);
    };
    const stop = (text: string, href?: string) => {
      window.clearInterval(timer);
      timer = undefined;
      say(text, href);
    };
    // a commit's files, drawn when they hold a result the page does not show
    const refresh = async (sha: string) => {
      const base = statusCommitBase(sha);
      const [latest, historyData, monthly] = await Promise.all([loadLatest(base), loadHistory(base), loadMonthly(base)]);
      if (!latest || (latest.run_id === shown?.run_id && latest.generated_at === shown?.generated_at)) return false;
      render(latest, historyData, monthly);
      return true;
    };
    const check = async (first = false) => {
      lastCheck = Date.now();
      if (first) {
        // a page opened before the latest run catches up at once
        const head = await statusHead();
        if (head) await refresh(head);
        return;
      }
      const runs = await statusRuns();
      if (!runs) {
        const head = await statusHead();
        if (head && (await refresh(head))) return stop(words.updated);
      } else {
        const run = runs.find((candidate) => Date.parse(candidate.created_at) >= startedAt - SKEW_MS);
        if (run?.status === "completed") {
          if (run.conclusion !== "success") return stop(words.failed, run.html_url);
          const head = await statusHead();
          if (head) await refresh(head);
          if (shown?.run_id === String(run.id)) return stop(words.updated);
        } else if (run) say(words.running, run.html_url);
      }
      if (Date.now() - startedAt > WAIT_MS) stop(words.waitedOut);
    };
    // the link opens GitHub in a new tab; clicking again starts the wait over
    trigger.addEventListener("click", () => {
      startedAt = Date.now();
      say(words.waiting);
      window.clearInterval(timer);
      timer = window.setInterval(() => void check(), POLL_MS);
      void check(true);
    });
    document.addEventListener("visibilitychange", () => {
      if (timer && !document.hidden && Date.now() - lastCheck > 30_000) void check();
    });
  }
</script>

<style is:global>
  /* the page's overall state: the card's border and its head band take the state's colour, the
     body under the band stays plain; grey before data and when no key is configured */
  .status-card {
    --card-border: var(--color-gray-200);
    --card-tint: var(--color-gray-50);
    border-color: var(--card-border);
  }
  .status-card-head {
    background: var(--card-tint);
  }
  .status-card[data-status="up"] {
    --card-border: var(--color-green-200);
    --card-tint: var(--color-green-50);
  }
  .status-card[data-status="degraded"] {
    --card-border: var(--color-amber-200);
    --card-tint: var(--color-amber-50);
  }
  .status-card[data-status="down"] {
    --card-border: var(--color-red-200);
    --card-tint: var(--color-red-50);
  }
  .dark .status-card {
    --card-border: var(--color-gray-800);
    --card-tint: var(--color-gray-900);
  }
  .dark .status-card[data-status="up"] {
    --card-border: rgb(34 197 94 / 0.35);
    --card-tint: rgb(34 197 94 / 0.1);
  }
  .dark .status-card[data-status="degraded"] {
    --card-border: rgb(245 158 11 / 0.35);
    --card-tint: rgb(245 158 11 / 0.1);
  }
  .dark .status-card[data-status="down"] {
    --card-border: rgb(239 68 68 / 0.35);
    --card-tint: rgb(239 68 68 / 0.1);
  }
  /* ‹ and ›, which move the window of days by one range */
  .status-page-button {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--color-gray-500);
    transition:
      background-color 150ms,
      color 150ms;
  }
  .status-page-button:hover:not(:disabled) {
    background: var(--color-gray-100);
    color: var(--color-gray-900);
  }
  .dark .status-page-button:hover:not(:disabled) {
    background: var(--color-gray-800);
    color: var(--color-gray-100);
  }
  .status-page-button:disabled {
    opacity: 0.35;
    cursor: default;
    background: none;
  }
  .status-block {
    border-bottom: 1px solid var(--color-gray-200);
    padding: 1.25rem 0;
    scroll-margin-top: 5rem;
  }
  .dark .status-block {
    border-bottom-color: var(--color-gray-800);
  }
  .status-metric {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
  }
  .status-metric-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .dark .status-metric-label {
    color: var(--color-gray-400);
  }
  /* one bar a day, 16 px tall as on status.openai.com: 90 of them fill the column, and the cap keeps
     7 or 30 from turning into slabs; on a phone the gaps narrow so the bars stay readable */
  .status-bars {
    display: flex;
    height: 1rem;
    gap: 2px;
  }
  @media (max-width: 639.98px) {
    .status-bars {
      gap: 1px;
    }
  }
  .status-bar {
    appearance: none;
    display: block;
    flex: 1 1 0;
    min-width: 0;
    max-width: 1.25rem;
    height: 1rem;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--status);
    cursor: pointer;
  }
  .status-bar:hover,
  .status-bar[data-active] {
    box-shadow: 0 0 0 1px var(--color-gray-500);
  }
  /* a day's card, the kit dialog's frame at a tooltip's size: it floats under the bars, or over
     them near the bottom of the window, so nothing moves when it opens */
  .status-day-card {
    position: absolute;
    top: calc(1rem + 4px);
    left: 0;
    z-index: 20;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--color-gray-200);
    border-radius: 0.5rem;
    background: var(--color-white);
    box-shadow: 0 24px 64px -16px rgb(0 0 0 / 0.25);
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity 150ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 150ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s 150ms;
  }
  .status-day-card[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .dark .status-day-card {
    border-color: var(--color-gray-800);
    background: var(--color-gray-950);
  }
  .status-state {
    font-size: 13px;
    font-weight: 500;
  }
  .status-error {
    margin-top: 0.5rem;
    font-size: 12px;
    color: var(--color-gray-500);
    overflow-wrap: anywhere;
  }
  .status-day-card .status-error {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin-top: 0.25rem;
    font-size: 11px;
  }
</style>

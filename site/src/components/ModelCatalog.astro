---
// The model catalog: one row per registry entry, built with the page, so it reads without
// JavaScript. A probed entry's latency and throughput come from the daily probe's files as the site
// is built, and link to its channel on the status page. The script searches and sorts the rows,
// switches the prices and their unit between USD and CNY, opens an entry's integration kit in a
// dialog from the button at the end of its row, copies its code or a prompt for an agent, and
// redraws the latency and throughput when the status-data branch has a newer run than the build.
// Marks point into the page's MarkSprite.
import VendorMark from "./VendorMark.astro";
import { STRINGS, localePath, type Locale } from "../shared/i18n";
import { agentPromptFor, catalogRows, formatContext, formatPrice, literal } from "../shared/catalog";
import { LATENCY_UNIT, PRICE_UNITS, isProbed, metricCells } from "../shared/catalog-status";
import { withCurrentKeys } from "../shared/status";
import { statusAtBuild } from "../shared/status-build";
import type { Modality } from "../../../src_ts/src/registry.ts";

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;
const s = STRINGS[locale].models;
const rows = catalogRows();
const providers = new Set(rows.map((row) => row.provider.name)).size;
// a Chinese reader sees the vendors' CNY list prices first; a choice made before wins
const currency = locale === "zh" ? "CNY" : "USD";
const latest = withCurrentKeys((await statusAtBuild()).latest);
const statusPage = localePath(locale, "/status/");
const targets = rows.map((row) => latest?.targets[row.key]);
// the header that sorts best first: the shortest latency, the highest throughput
const SORT_FIRST: Record<string, "asc" | "desc"> = { latency: "asc", throughput: "desc" };

const INPUTS: Modality[] = ["Text", "Image", "Video", "Audio"];
const OUTPUTS: Modality[] = ["Text", "Image", "Audio", "Embed"];
// Lucide: type, image, video, audio-lines, axis-3d
const MODALITY_ICONS: Record<Modality, string> = {
  Text: '<path d="M4 7V4h16v3"></path><path d="M9 20h6"></path><path d="M12 4v16"></path>',
  Image: '<rect width="18" height="18" x="3" y="3" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>',
  Video: '<path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"></path><rect x="2" y="6" width="14" height="12" rx="2"></rect>',
  Audio: '<path d="M2 10v3"></path><path d="M6 6v11"></path><path d="M10 3v18"></path><path d="M14 8v7"></path><path d="M18 5v13"></path><path d="M22 10v3"></path>',
  Embed: '<path d="M13.5 10.5 15 9"></path><path d="M4 4v15a1 1 0 0 0 1 1h15"></path><path d="M4.293 19.707 6 18"></path><path d="m9 15 1.5-1.5"></path>',
};

const price = (value: number | undefined) => (value === undefined ? undefined : formatPrice(value));
// each tab's file and the lines that install, key and run it; the Server tab's file is a whole
// mmsp-server.json, started in the background so one paste also streams one answer through it
const kits = rows.map((row) => {
  const { model, base_url, output_modalities, kit } = row;
  const hint = kit.keyHint?.[locale];
  const keyLine = `export ${kit.keyEnv}=${kit.keyValue}` + (hint && hint !== kit.keyValue ? `  # ${hint}` : "");
  // a single-quoted shell word cannot hold a single quote, so the prompt's quotes become escaped
  // double quotes
  const body = literal(kit.request, "json").replaceAll("'", '\\"');
  // an embedding, an image or speech streams as lines of numbers or base64; their heads show it
  const heads = output_modalities.includes("Text") ? "" : " | cut -c 1-160";
  return {
    model,
    baseUrl: base_url,
    typescript: kit.typescript,
    python: kit.python,
    agent: agentPromptFor(row, locale),
    server: JSON.stringify({ models: [kit.server], api_keys: ["$MMSP_SERVER_API_KEY"] }, null, 2),
    run: {
      typescript: ["npm install @prismshadow/mmsp", keyLine, "npx tsx main.ts"].join("\n"),
      python: ["pip install mmsp", keyLine, "python main.py"].join("\n"),
      server: [
        "pip install mmsp",
        keyLine,
        "export MMSP_SERVER_API_KEY=secret",
        "python -m mmsp.integration.server --config mmsp-server.json &",
        "curl -sSN --retry 5 --retry-connrefused http://127.0.0.1:25752/v1/stream \\",
        '  -H "Authorization: Bearer $MMSP_SERVER_API_KEY" -H "Content-Type: application/json" \\',
        `  -d '${body}'${heads}`,
      ].join("\n"),
    },
  };
});
const columns = s.columns;
// the units sit in the headers, small, so the cells hold bare numbers; the prices' follows the switch
const units = { price: PRICE_UNITS[currency], latency: LATENCY_UNIT, throughput: s.status.tps };
const priceTitle = `${currency} ${s.perMillion}`;
const head = "px-3 py-2.5 text-[11px] font-medium tracking-wider text-gray-500 uppercase dark:text-gray-400";
const sortButton =
  "group items-center gap-1 whitespace-nowrap uppercase transition-colors hover:text-gray-900 dark:hover:text-gray-100";
// a right-aligned header holds its label at the cell's right edge, over the numbers, so a label
// wider than a narrow column runs into its own padding on the left instead of under the next header
const sortRight = "flex w-full flex-row-reverse";
const icon = "h-3.5 w-3.5";
const stroke = { fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round" };
---

<section
  class:list={["catalog", className]}
  data-catalog
  data-currency={currency}
  data-words={JSON.stringify({ ...s.status, ...s.kit, models: s.models, perMillion: s.perMillion })}
  data-status-page={statusPage}
  data-run-id={latest?.run_id}
>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
    <label class="relative w-full sm:w-72">
      <span class="sr-only">{s.search}</span>
      <svg viewBox="0 0 24 24" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400" {...stroke} aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="search"
        placeholder={s.search}
        autocomplete="off"
        spellcheck="false"
        data-catalog-search
        class="h-9 w-full rounded-lg border border-gray-200 bg-white pr-3 pl-9 text-sm placeholder:text-gray-400 focus:border-gray-400 focus:outline-none dark:border-gray-800 dark:bg-gray-950 dark:placeholder:text-gray-500 dark:focus:border-gray-600"
      />
    </label>
    <p class="text-[13px] text-gray-500 tabular-nums dark:text-gray-400">
      <span data-catalog-count>{s.models.replace("{n}", String(rows.length))}</span>
      <span aria-hidden="true"> · </span>
      <span>{s.providers.replace("{n}", String(providers))}</span>
    </p>

    <div class="ml-auto flex items-center gap-3">
      <div class="segmented" role="radiogroup" aria-label={s.currency} data-segmented data-value={currency} style={`--i: ${currency === "CNY" ? 1 : 0}`}>
        <span class="segmented-thumb" aria-hidden="true"></span>
        <button type="button" role="radio" aria-checked={currency === "USD" ? "true" : "false"} data-value="USD">USD</button>
        <button type="button" role="radio" aria-checked={currency === "CNY" ? "true" : "false"} data-value="CNY">CNY</button>
      </div>
      <a
        href="/models.json"
        title={s.json}
        class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-gray-200 px-2.5 text-xs font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-gray-950 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white"
      >
        <svg viewBox="0 0 24 24" class={icon} {...stroke} aria-hidden="true">
          <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"></path>
          <path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"></path>
        </svg>
        JSON
      </a>
    </div>
  </div>

  <!-- the modality icons once, as symbols every row points at -->
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    {Object.entries(MODALITY_ICONS).map(([modality, paths]) => <symbol id={`modality-${modality}`} viewBox="0 0 24 24" {...stroke} set:html={paths} />)}
  </svg>

  <table class="catalog-table mt-4 w-full text-sm">
    <colgroup>
      <col />
      <col class="w-40" />
      <col class="w-28" />
      <col class="w-16" />
      {/* a price is up to seven characters, 0.00286 */}
      <col class="w-20" />
      <col class="w-20" />
      <col class="w-20" />
      <col class="w-24" />
      {/* "Throughput" and its unit, tok/s, are the widest header */}
      <col class="w-30" />
      <col class="w-10" />
    </colgroup>
    <thead>
      <tr class="border-b border-gray-200 text-left dark:border-gray-800">
        {
          (
            [
              ["model", columns.model, "left", null],
              ["provider", columns.provider, "left", null],
              [null, columns.modalities, "left", null],
              ["context", columns.context, "right", null],
              ["input", columns.input, "right", "price"],
              ["output", columns.output, "right", "price"],
              ["cached", columns.cached, "right", "price"],
              ["latency", columns.latency, "right", "latency"],
              ["throughput", columns.throughput, "right", "throughput"],
            ] as const
          ).map(([key, label, align, unit]) => (
            <th
              scope="col"
              class:list={[head, align === "right" && "text-right"]}
              data-sort-key={key ?? undefined}
              data-sort-first={key ? SORT_FIRST[key] : undefined}
              aria-sort={key ? "none" : undefined}
            >
              {key ? (
                <button type="button" class:list={[sortButton, align === "right" ? sortRight : "inline-flex"]}>
                  <span>
                    {label}
                    {unit ? " " : ""}
                    {unit && (
                      <span class="catalog-unit" data-price-unit={unit === "price" ? "" : undefined} title={unit === "price" ? priceTitle : undefined}>
                        {units[unit]}
                      </span>
                    )}
                  </span>
                  <svg viewBox="0 0 24 24" class="sort-icon h-3 w-3" {...stroke} aria-hidden="true">
                    <path d="m7 15 5 5 5-5"></path>
                    <path d="m7 9 5-5 5 5"></path>
                  </svg>
                </button>
              ) : (
                label
              )}
            </th>
          ))
        }
        <th scope="col" class:list={[head, "text-right"]} data-head="kit">{s.kit.code}</th>
      </tr>
    </thead>
    <tbody data-catalog-body>
      {
        rows.map((row, index) => {
          const usd = row.pricing;
          const cny = row.pricing_cny;
          const prices = [
            ["input", columns.input, usd?.prompt_tokens, cny?.prompt_tokens],
            ["output", columns.output, usd?.response_tokens, cny?.response_tokens],
            ["cached", columns.cached, usd?.cached_tokens, cny?.cached_tokens],
          ] as const;
          const target = targets[index];
          const probe = isProbed(target) ? target : undefined;
          const cells = metricCells(target, s.status, statusPage, row.key);
          const metric = "mono text-right text-[13px] tabular-nums whitespace-nowrap";
          return (
            <tr
              data-row
              data-index={index}
              data-key={row.key}
              data-search={[row.model, row.provider.name, row.vendor?.name, row.client, row.base_url].filter(Boolean).join(" ").toLowerCase()}
              data-model={row.model.toLowerCase()}
              data-provider={row.provider.name.toLowerCase()}
              data-context={row.context_window}
              data-input={usd?.prompt_tokens}
              data-output={usd?.response_tokens}
              data-cached={usd?.cached_tokens}
              data-status={probe?.status}
              data-ttft={probe?.ttft_ms ?? undefined}
              data-tps={probe?.tps ?? undefined}
            >
              <td data-cell="model">
                <span class="flex min-w-0 items-center gap-2">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center" title={row.vendor?.name} data-row-mark>
                    {row.vendor?.mark && <VendorMark id={row.vendor.mark} title={row.vendor.name} />}
                  </span>
                  <span class="mono truncate text-[13px]" title={row.model}>{row.model}</span>
                </span>
              </td>
              <td data-cell="provider">
                <span class="flex min-w-0 items-center gap-2 text-gray-600 dark:text-gray-400">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center">{row.provider.mark && <VendorMark id={row.provider.mark} title={row.provider.name} />}</span>
                  <span class="truncate text-[13px]" title={row.base_url}>{row.provider.name}</span>
                </span>
              </td>
              <td data-cell="modalities">
                <span class="flex items-center gap-1 text-gray-500 dark:text-gray-400">
                  {INPUTS.map((modality) => (
                    <span class:list={["modality", !row.input_modalities.includes(modality) && "modality-empty"]} title={row.input_modalities.includes(modality) ? `${s.modality.in}: ${s.modality[modality]}` : undefined}>
                      {row.input_modalities.includes(modality) && <svg class={icon} aria-label={`${s.modality.in}: ${s.modality[modality]}`} role="img"><use href={`#modality-${modality}`} /></svg>}
                    </span>
                  ))}
                  <svg viewBox="0 0 24 24" class="mx-0.5 h-3 w-3 shrink-0 text-gray-300 dark:text-gray-600" {...stroke} aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                  {OUTPUTS.filter((modality) => row.output_modalities.includes(modality)).map((modality) => (
                    <span class="modality" title={`${s.modality.out}: ${s.modality[modality]}`}>
                      <svg class={icon} aria-label={`${s.modality.out}: ${s.modality[modality]}`} role="img"><use href={`#modality-${modality}`} /></svg>
                    </span>
                  ))}
                </span>
              </td>
              <td data-cell="context" class="mono text-right text-[13px] tabular-nums" title={row.context_window?.toLocaleString("en-US")} data-label={columns.context}>
                {row.context_window ? formatContext(row.context_window) : <span class="text-gray-300 dark:text-gray-600">—</span>}
              </td>
              {prices.map(([cell, label, inUsd, inCny]) => (
                <td
                  data-cell={cell}
                  data-price
                  data-usd={price(inUsd)}
                  data-cny={price(inCny)}
                  data-label={label}
                  data-unit={units.price}
                  class:list={["mono text-right text-[13px] tabular-nums", inUsd === undefined && "text-gray-300 dark:text-gray-600"]}
                >
                  {(currency === "CNY" ? price(inCny) : price(inUsd)) ?? "—"}
                </td>
              ))}
              <td data-cell="latency" data-label={columns.latency} data-unit={units.latency} class={metric} set:html={cells.latency} />
              <td data-cell="throughput" data-label={columns.throughput} data-unit={units.throughput} class={metric} set:html={cells.throughput} />
              <td data-cell="kit" class="text-right">
                <button type="button" class="catalog-kit" aria-haspopup="dialog" aria-label={s.kit.show.replace("{model}", row.model)}>
                  <svg viewBox="0 0 24 24" class={icon} {...stroke} aria-hidden="true">
                    <path d="m16 18 6-6-6-6"></path>
                    <path d="m8 6-6 6 6 6"></path>
                  </svg>
                </button>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  <p class="py-10 text-center text-sm text-gray-500 dark:text-gray-400" data-catalog-empty hidden>{s.noMatch}</p>
  <dialog class="kit-dialog" data-kit-dialog aria-labelledby="catalog-kit-title">
    <div class="kit-panel" tabindex="-1" data-kit-panel>
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 id="catalog-kit-title" class="flex items-center gap-2 text-[15px] font-semibold">
            <span class="flex h-4 w-4 shrink-0 items-center justify-center" data-kit-mark></span>
            <span class="mono break-all" data-kit-model></span>
          </h2>
          <p class="mt-1 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-[13px]">
            <span class="flex min-w-0 items-center gap-2 text-gray-600 dark:text-gray-400" data-kit-provider></span>
            <span class="mono truncate text-xs text-gray-400 dark:text-gray-500" data-kit-url></span>
          </p>
        </div>
        <button type="button" class="kit-close" aria-label={s.kit.close} data-kit-close>
          <svg viewBox="0 0 24 24" class="h-4 w-4" {...stroke} aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
      </div>
      <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-gray-600 dark:text-gray-400">
        <span class="flex items-center gap-1" data-kit-modalities></span>
        <span><span class="text-gray-400 dark:text-gray-500">{columns.context}</span> <span class="mono tabular-nums" data-kit-context></span></span>
        <span class="mono tabular-nums" data-kit-prices></span>
        <span class="contents" data-kit-status></span>
      </p>
      <div class="code-group" data-ready>
        <div class="tab-strip items-center" role="tablist">
          <button type="button" role="tab" data-kit-tab="TypeScript">TypeScript</button>
          <button type="button" role="tab" data-kit-tab="Python">Python</button>
          <button type="button" role="tab" data-kit-tab="Server">{s.kit.server}</button>
          <span class="mono ml-auto text-xs text-gray-400 max-md:hidden dark:text-gray-500" data-kit-file></span>
          <span class="kit-copies max-md:ml-auto">
            <button type="button" class="kit-copy" data-kit-copy="code">
              <svg viewBox="0 0 24 24" class={icon} {...stroke} aria-hidden="true">
                <rect x="8" y="8" width="14" height="14" rx="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <span>{s.kit.copyCode}</span>
            </button>
            {/* Lucide: bot */}
            <button type="button" class="kit-copy" title={s.kit.agentHint} data-kit-copy="agent">
              <svg viewBox="0 0 24 24" class={icon} {...stroke} aria-hidden="true">
                <path d="M12 8V4H8"></path>
                <rect width="16" height="12" x="4" y="8" rx="2"></rect>
                <path d="M2 14h2"></path>
                <path d="M20 14h2"></path>
                <path d="M15 13v2"></path>
                <path d="M9 13v2"></path>
              </svg>
              <span>{s.kit.copyAgent}</span>
            </button>
          </span>
        </div>
        <pre class="astro-code kit-code"><code data-kit-code></code></pre>
      </div>
      <p class="mt-3 text-[11px] font-medium tracking-wider text-gray-500 uppercase dark:text-gray-400">{s.kit.run}</p>
      <pre class="astro-code kit-code mt-1"><code data-kit-run></code></pre>
    </div>
  </dialog>
  <script type="application/json" data-catalog-kits set:html={JSON.stringify(kits).replaceAll("<", "\\u003c")} />
</section>

<style is:global>
  /* ---------- the table: columns on a desktop; on narrower screens each row stacks, the model and
     its code button first, then the provider, the context and the modalities, then the prices, then
     a probed entry's latency and throughput */
  .catalog-table {
    border-collapse: collapse;
  }
  .catalog-table td {
    padding: 0.5rem 0.75rem;
    vertical-align: middle;
  }
  .catalog-table tr[data-row] {
    border-bottom: 1px solid var(--color-gray-100);
  }
  .dark .catalog-table tr[data-row] {
    border-bottom-color: var(--color-gray-900);
  }
  .catalog-table tr[data-open] {
    background: var(--color-gray-50);
  }
  .dark .catalog-table tr[data-open] {
    background: var(--color-gray-900);
  }
  @media (hover: hover) and (min-width: 1024px) {
    .catalog-table tr[data-row]:hover {
      background: var(--color-gray-50);
    }
    .dark .catalog-table tr[data-row]:hover {
      background: var(--color-gray-900);
    }
  }
  .catalog-kit {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--color-gray-400);
    transition:
      background-color 150ms cubic-bezier(0.23, 1, 0.32, 1),
      color 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .catalog-kit:hover {
    background: var(--color-gray-100);
    color: var(--color-gray-900);
  }
  .dark .catalog-kit:hover {
    background: var(--color-gray-800);
    color: var(--color-gray-100);
  }
  .catalog-metric {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }
  .catalog-metric:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* a column's unit after its name: smaller, muted, on the name's baseline */
  .catalog-unit {
    font-size: 0.8em;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    color: var(--color-gray-400);
  }
  .dark .catalog-unit {
    color: var(--color-gray-500);
  }
  .modality {
    display: inline-flex;
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
  }
  .catalog-table th[aria-sort] .sort-icon {
    opacity: 0;
  }
  .catalog-table th[aria-sort] button:hover .sort-icon,
  .catalog-table th[aria-sort="ascending"] .sort-icon,
  .catalog-table th[aria-sort="descending"] .sort-icon {
    opacity: 1;
  }
  .catalog-table th[aria-sort="ascending"],
  .catalog-table th[aria-sort="descending"] {
    color: var(--color-gray-900);
  }
  .dark .catalog-table th[aria-sort="ascending"],
  .dark .catalog-table th[aria-sort="descending"] {
    color: var(--color-gray-100);
  }
  .catalog-table th[aria-sort="ascending"] .sort-icon path:first-child,
  .catalog-table th[aria-sort="descending"] .sort-icon path:last-child {
    opacity: 0;
  }

  @media (min-width: 1024px) {
    .catalog-table {
      table-layout: fixed;
    }
    .catalog-table thead th {
      position: sticky;
      top: 3.5rem;
      z-index: 1;
      background: var(--color-white);
    }
    .dark .catalog-table thead th {
      background: var(--color-gray-950);
    }
    .catalog-table thead th {
      box-shadow: inset 0 -1px var(--color-gray-200);
    }
    .dark .catalog-table thead th {
      box-shadow: inset 0 -1px var(--color-gray-800);
    }
    /* the header names the column where its ids begin, past the mark */
    .catalog-table th[data-sort-key="model"] {
      padding-left: 2.25rem;
    }
    /* the code button fills its column and ends with the table, no taller than a row of text; its
       header ends where the buttons do */
    .catalog-table td[data-cell="kit"] {
      padding: 0 0 0 0.5rem;
    }
    .catalog-table th[data-head="kit"] {
      padding-inline: 0;
    }
  }

  @media (max-width: 1023.98px) {
    .catalog-table,
    .catalog-table tbody {
      display: block;
    }
    .catalog-table colgroup,
    .catalog-table thead {
      display: none;
    }
    .catalog-table tr[data-row] {
      display: grid;
      /* the first column is the mark and its gap, so the lines under the model id start where it
         does; an entry the probe has not reached has no fourth line */
      grid-template-columns: 1.5rem auto auto minmax(0, 1fr) 2.25rem;
      grid-template-areas:
        "model model model model kit"
        ". provider context modalities modalities"
        ". input output cached cached";
      row-gap: 0.25rem;
      padding: 0.625rem 0;
    }
    /* the throughput runs to the row's end, so its label does not widen the context and output
       column above it */
    .catalog-table tr[data-row][data-status] {
      grid-template-areas:
        "model model model model kit"
        ". provider context modalities modalities"
        ". input output cached cached"
        ". latency throughput throughput throughput";
    }
    .catalog-table tr[data-row]:not([data-status]) td[data-cell="latency"],
    .catalog-table tr[data-row]:not([data-status]) td[data-cell="throughput"] {
      display: none;
    }
    .catalog-table td {
      padding: 0;
    }
    /* the empty input slots that align the icons from row to row on a desktop */
    .catalog-table .modality-empty {
      display: none;
    }
    .catalog-table td[data-cell="model"] {
      grid-area: model;
      align-self: center;
      min-width: 0;
      padding-right: 0.75rem;
    }
    .catalog-table td[data-cell="kit"] {
      grid-area: kit;
      align-self: center;
      justify-self: end;
    }
    /* the button reaches into the row's padding, so the first line is as tall as the id */
    .catalog-table td[data-cell="kit"] .catalog-kit {
      margin-block: -0.375rem;
    }
    .catalog-table td[data-cell="provider"] {
      grid-area: provider;
      min-width: 0;
      padding-right: 0.5rem;
    }
    .catalog-table td[data-cell="context"] {
      grid-area: context;
      padding-right: 0.5rem;
      text-align: left;
    }
    .catalog-table td[data-cell="modalities"] {
      grid-area: modalities;
    }
    .catalog-table td[data-cell="input"] {
      grid-area: input;
      padding-right: 0.5rem;
    }
    .catalog-table td[data-cell="output"] {
      grid-area: output;
      padding-right: 0.5rem;
    }
    .catalog-table td[data-cell="cached"] {
      grid-area: cached;
    }
    .catalog-table td[data-cell="latency"] {
      grid-area: latency;
      padding-right: 0.5rem;
    }
    .catalog-table td[data-cell="throughput"] {
      grid-area: throughput;
    }
    /* each figure after its column's name and unit, the unit small as in the desktop's headers; a line
       too narrow for its three prices puts a value under its name rather than past the row */
    .catalog-table td[data-price],
    .catalog-table td[data-cell="latency"],
    .catalog-table td[data-cell="throughput"] {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      white-space: nowrap;
    }
    .catalog-table td[data-price]::before,
    .catalog-table td[data-cell="latency"]::before,
    .catalog-table td[data-cell="throughput"]::before,
    .catalog-table td[data-price]::after,
    .catalog-table td[data-cell="latency"]::after,
    .catalog-table td[data-cell="throughput"]::after {
      font-family: ui-sans-serif, system-ui, sans-serif;
      color: var(--color-gray-400);
    }
    .catalog-table td[data-price]::before,
    .catalog-table td[data-cell="latency"]::before,
    .catalog-table td[data-cell="throughput"]::before {
      content: attr(data-label);
      order: -2;
      margin-right: 0.125rem;
      font-size: 11px;
    }
    .catalog-table td[data-price]::after,
    .catalog-table td[data-cell="latency"]::after,
    .catalog-table td[data-cell="throughput"]::after {
      content: attr(data-unit);
      order: -1;
      margin-right: 0.25rem;
      font-size: 8.5px;
    }
  }

  /* ---------- the integration kit: a dialog over the page, which holds still under it; the panel
     scrolls on a short screen and the code scrolls sideways */
  .kit-dialog {
    width: calc(100% - 2rem);
    max-width: 50rem;
    max-height: calc(100dvh - 2rem);
    /* held at the top, so a tab of another length changes the dialog's height, not where its tabs
       are */
    margin: 1rem auto auto;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--color-gray-200);
    border-radius: 0.75rem;
    background: var(--color-white);
    color: inherit;
    box-shadow: 0 24px 64px -16px rgb(0 0 0 / 0.25);
  }
  @media (min-width: 640px) {
    .kit-dialog {
      max-height: calc(100dvh - 4rem);
      margin-top: 2rem;
    }
  }
  .kit-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: kit-in 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .dark .kit-dialog {
    border-color: var(--color-gray-800);
    background: var(--color-gray-950);
  }
  .kit-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  .dark .kit-dialog::backdrop {
    background: rgb(0 0 0 / 0.65);
  }
  .kit-dialog[open]::backdrop {
    animation: kit-fade 150ms ease-out;
  }
  @keyframes kit-in {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
  }
  @keyframes kit-fade {
    from {
      opacity: 0;
    }
  }
  .kit-panel {
    min-height: 0;
    overflow: auto;
    padding: 1rem 1.25rem 1.25rem;
    outline: none;
  }
  .kit-copies {
    display: flex;
    gap: 0.25rem;
  }
  /* on a phone the file name gives way, the tabs narrow, and the two copy buttons take a line of
     their own above the tabs, so the selected tab still meets the code */
  @media (max-width: 639.98px) {
    .kit-panel {
      padding: 0.875rem 1rem 1rem;
    }
    .kit-panel .code-group .tab-strip button {
      padding-inline: 0.5rem;
    }
    .kit-copies {
      order: -1;
      flex-basis: 100%;
      justify-content: flex-end;
    }
  }
  /* the page keeps its scrollbar's room, so it does not shift sideways */
  html.kit-open {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  .kit-close {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--color-gray-500);
  }
  .kit-close:hover {
    background: var(--color-gray-100);
    color: var(--color-gray-900);
  }
  .dark .kit-close:hover {
    background: var(--color-gray-800);
    color: var(--color-gray-100);
  }
  .kit-panel .code-group {
    margin: 1rem 0 0;
  }
  .kit-panel .modality-empty {
    display: none;
  }
  .kit-code {
    white-space: pre;
  }
  .code-group .tab-strip .kit-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.25rem;
    border-radius: 0.375rem;
    border-bottom: 0;
    padding: 0.25rem 0.5rem;
    font-size: 12px;
  }
</style>

<script>
  import { PRICE_UNITS, isProbed, metricCells, type MetricWords } from "../shared/catalog-status";
  import { loadLatest, statusQuery, withCurrentKeys, type Status } from "../shared/status";

  type Tab = "typescript" | "python" | "server";
  interface KitText {
    model: string;
    baseUrl: string;
    typescript: string;
    python: string;
    // the prompt "Copy for agent" puts on the clipboard
    agent: string;
    server: string;
    run: Record<Tab, string>;
  }
  type Words = MetricWords & { copied: string; copyFailed: string; models: string; perMillion: string };

  const stored = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const store = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {}
  };

  const root = document.querySelector<HTMLElement>("[data-catalog]");
  if (root) {
    const words = JSON.parse(root.dataset.words!) as Words;
    const kits = JSON.parse(root.querySelector("[data-catalog-kits]")!.textContent!) as KitText[];
    const body = root.querySelector<HTMLElement>("[data-catalog-body]")!;
    const rows = [...body.querySelectorAll<HTMLTableRowElement>("tr[data-row]")];
    const dialog = root.querySelector<HTMLDialogElement>("[data-kit-dialog]")!;

    // ---------- the kit: one dialog, filled from the row that opens it; the language follows the
    // site's code groups (mmsp-site.code), so a reader of Python docs opens Python here
    const LANGUAGES = ["TypeScript", "Python", "Server"];
    const FILES: Record<Tab, string> = { typescript: "main.ts", python: "main.py", server: "mmsp-server.json" };
    const tabOf = (language: string): Tab => (language === "Python" ? "python" : language === "Server" ? "server" : "typescript");
    const panel = dialog.querySelector<HTMLElement>("[data-kit-panel]")!;
    const tabs = [...dialog.querySelectorAll<HTMLButtonElement>("[data-kit-tab]")];
    const code = dialog.querySelector<HTMLElement>("[data-kit-code]")!;
    const run = dialog.querySelector<HTMLElement>("[data-kit-run]")!;
    const file = dialog.querySelector<HTMLElement>("[data-kit-file]")!;
    const slot = (name: string) => dialog.querySelector<HTMLElement>(`[data-kit-${name}]`)!;
    const clones = (parent: Element | null | undefined) => [...(parent?.children ?? [])].map((child) => child.cloneNode(true));
    let language = LANGUAGES.includes(stored("mmsp-site.code") ?? "") ? stored("mmsp-site.code")! : LANGUAGES[0];
    let open: HTMLTableRowElement | null = null;

    const renderKit = () => {
      if (!open) return;
      const kit = kits[Number(open.dataset.index)];
      const tab = tabOf(language);
      code.textContent = kit[tab];
      run.textContent = kit.run[tab];
      file.textContent = FILES[tab];
      for (const button of tabs) button.setAttribute("aria-selected", String(button.dataset.kitTab === language));
    };
    const show = (row: HTMLTableRowElement) => {
      const kit = kits[Number(row.dataset.index)];
      open = row;
      row.dataset.open = "";
      slot("model").textContent = kit.model;
      slot("url").textContent = kit.baseUrl;
      slot("url").title = kit.baseUrl;
      slot("mark").replaceChildren(...clones(row.querySelector("[data-row-mark]")));
      slot("provider").replaceChildren(...clones(row.querySelector('[data-cell="provider"] > span')));
      slot("modalities").replaceChildren(...clones(row.querySelector('[data-cell="modalities"] > span')));
      slot("context").textContent = row.querySelector('[data-cell="context"]')!.textContent!.trim();
      const prices = [...row.querySelectorAll<HTMLElement>("[data-price]")].filter((cell) => cell.textContent !== "—");
      slot("prices").textContent = prices.length
        ? `${prices.map((cell) => `${cell.dataset.label} ${cell.textContent}`).join(" · ")} ${segmented.dataset.value} ${words.perMillion}`
        : "";
      // a probed entry's latency and throughput, each after its column's name as the context is,
      // with their units, since the dialog has no headers to carry them
      const status = row.dataset.status as Status | undefined;
      const numeric = (data: string | undefined) => (data === undefined ? null : Number(data));
      const figures = status
        ? metricCells({ status, ttft_ms: numeric(row.dataset.ttft), tps: numeric(row.dataset.tps) }, words, root.dataset.statusPage! + statusQuery(), row.dataset.key!, true)
        : null;
      slot("status").replaceChildren(
        ...(figures ? (["latency", "throughput"] as const) : []).map((name) => {
          const item = document.createElement("span");
          const label = document.createElement("span");
          label.className = "text-gray-400 dark:text-gray-500";
          label.textContent = row.querySelector<HTMLElement>(`[data-cell="${name}"]`)!.dataset.label!;
          const value = document.createElement("span");
          value.className = "mono tabular-nums";
          value.innerHTML = figures![name];
          item.append(label, " ", value);
          return item;
        }),
      );
      renderKit();
      document.documentElement.classList.add("kit-open");
      dialog.showModal();
      panel.focus({ preventScroll: true });
    };
    // the copy buttons' labels go back to their names when the dialog closes, so the next entry's
    // kit does not open saying Copied
    const settle: (() => void)[] = [];
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("kit-open");
      for (const done of settle) done();
      if (!open) return;
      open.removeAttribute("data-open");
      open.querySelector<HTMLElement>(".catalog-kit")!.focus();
      open = null;
    });
    slot("close").addEventListener("click", () => dialog.close());
    // a click on the backdrop lands on the dialog itself; one that began inside, as a selection of
    // the code dragged out, does not close it
    let pressedOutside = false;
    dialog.addEventListener("pointerdown", (event) => (pressedOutside = event.target === dialog));
    dialog.addEventListener("click", (event) => {
      if (pressedOutside && event.target === dialog) dialog.close();
    });
    for (const row of rows) row.querySelector(".catalog-kit")!.addEventListener("click", () => show(row));
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        language = tab.dataset.kitTab!;
        store("mmsp-site.code", language);
        renderKit();
      });
    }
    // Copy code takes the open tab's file as it reads; Copy for agent, the entry's agent prompt.
    // Each says what happened in its own label for two seconds.
    for (const button of dialog.querySelectorAll<HTMLButtonElement>("[data-kit-copy]")) {
      const label = button.querySelector("span")!;
      const idle = label.textContent!;
      let reset: number | undefined;
      settle.push(() => {
        window.clearTimeout(reset);
        label.textContent = idle;
      });
      button.addEventListener("click", async () => {
        const text = button.dataset.kitCopy === "agent" ? (open ? kits[Number(open.dataset.index)].agent : "") : code.textContent;
        // held at its width while its label changes, so the button beside it stays put
        button.style.minWidth = `${button.offsetWidth}px`;
        try {
          await navigator.clipboard.writeText(text ?? "");
          label.textContent = words.copied;
        } catch {
          label.textContent = words.copyFailed;
        }
        window.clearTimeout(reset);
        reset = window.setTimeout(() => (label.textContent = idle), 2000);
      });
    }

    // ---------- search: every word typed must appear in the model, provider, vendor, client or URL
    const search = root.querySelector<HTMLInputElement>("[data-catalog-search]")!;
    const count = root.querySelector<HTMLElement>("[data-catalog-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-catalog-empty]")!;
    const filter = () => {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const row of rows) {
        row.hidden = !terms.every((term) => row.dataset.search!.includes(term));
        if (!row.hidden) shown += 1;
      }
      count.textContent = words.models.replace("{n}", terms.length ? `${shown} / ${rows.length}` : String(rows.length));
      empty.hidden = shown > 0;
    };
    search.addEventListener("input", filter);

    // ---------- sort: a header cycles through ascending, descending and the registry's order, or
    // through descending first where the highest is best (data-sort-first); an entry without the
    // value sorts last either way
    const headers = [...root.querySelectorAll<HTMLElement>("th[data-sort-key]")];
    let sortKey: string | null = null;
    let direction = 0;
    const PROBED: Record<string, string> = { latency: "ttft", throughput: "tps" };
    const value = (row: HTMLTableRowElement, key: string): number | string | undefined => {
      if (key === "model" || key === "provider") return row.dataset[key];
      const raw = row.dataset[PROBED[key] ?? key];
      return raw === undefined || raw === "" ? undefined : Number(raw);
    };
    const sort = () => {
      const ordered = [...rows];
      if (sortKey && direction) {
        const key = sortKey;
        ordered.sort((a, b) => {
          const left = value(a, key);
          const right = value(b, key);
          if (left === undefined || right === undefined) return left === right ? 0 : left === undefined ? 1 : -1;
          const order = typeof left === "string" ? left.localeCompare(String(right)) : left - Number(right);
          return order * direction;
        });
      }
      body.append(...ordered);
      for (const header of headers) {
        const sorted = header.dataset.sortKey === sortKey && direction !== 0;
        header.setAttribute("aria-sort", sorted ? (direction > 0 ? "ascending" : "descending") : "none");
      }
    };
    for (const header of headers) {
      const first = header.dataset.sortFirst === "desc" ? -1 : 1;
      header.querySelector("button")!.addEventListener("click", () => {
        if (header.dataset.sortKey !== sortKey) {
          sortKey = header.dataset.sortKey!;
          direction = first;
        } else {
          direction = direction === first ? -first : direction === -first ? 0 : first;
        }
        sort();
      });
    }

    // ---------- USD or CNY, kept for the next visit
    const segmented = root.querySelector<HTMLElement>("[data-segmented]")!;
    const prices = [...root.querySelectorAll<HTMLElement>("[data-price]")];
    const priceUnits = [...root.querySelectorAll<HTMLElement>("[data-price-unit]")];
    const applyCurrency = (currency: "USD" | "CNY") => {
      segmented.dataset.value = currency;
      segmented.style.setProperty("--i", currency === "CNY" ? "1" : "0");
      for (const button of segmented.querySelectorAll<HTMLButtonElement>("button")) {
        button.setAttribute("aria-checked", String(button.dataset.value === currency));
      }
      for (const unit of priceUnits) {
        unit.textContent = PRICE_UNITS[currency];
        unit.title = `${currency} ${words.perMillion}`;
      }
      for (const cell of prices) {
        cell.textContent = (currency === "CNY" ? cell.dataset.cny : cell.dataset.usd) ?? "—";
        cell.dataset.unit = PRICE_UNITS[currency];
      }
    };
    for (const button of segmented.querySelectorAll<HTMLButtonElement>("button")) {
      button.addEventListener("click", () => {
        store("mmsp-site.currency", button.dataset.value!);
        applyCurrency(button.dataset.value as "USD" | "CNY");
      });
    }
    const chosen = stored("mmsp-site.currency");
    if (chosen === "USD" || chosen === "CNY") applyCurrency(chosen);

    // ---------- the daily probe: the page carries the run that was the latest when it was built; a
    // newer run on the branch redraws every row's latency and throughput with the cells the build
    // drew (a ?status= override on this machine always does, so its links keep the override)
    const setData = (row: HTMLTableRowElement, name: string, data: string | number | null | undefined) => {
      if (data === null || data === undefined) delete row.dataset[name];
      else row.dataset[name] = String(data);
    };
    void loadLatest().then((loaded) => {
      const latest = withCurrentKeys(loaded);
      if (!latest || (latest.run_id === root.dataset.runId && !statusQuery())) return;
      root.dataset.runId = latest.run_id;
      const page = root.dataset.statusPage! + statusQuery();
      for (const row of rows) {
        const key = row.dataset.key!;
        const target = latest.targets[key];
        const probe = isProbed(target) ? target : undefined;
        setData(row, "status", probe?.status);
        setData(row, "ttft", probe?.ttft_ms);
        setData(row, "tps", probe?.tps);
        const cells = metricCells(target, words, page, key);
        row.querySelector('[data-cell="latency"]')!.innerHTML = cells.latency;
        row.querySelector('[data-cell="throughput"]')!.innerHTML = cells.throughput;
      }
      if (sortKey && direction) sort();
    });
  }
</script>

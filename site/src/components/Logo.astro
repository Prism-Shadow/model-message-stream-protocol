---
// the four letters in a grid: the mark of the site, the favicon and the artwork
interface Props {
  class?: string;
}
const { class: className = "h-7 w-7" } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <rect width="32" height="32" rx="7" class="fill-black dark:fill-gray-800"></rect>
  <rect x="3" y="16" width="13" height="13" rx="0" fill="#7c4dff"></rect>
  <path d="M16 3v26M3 16h26" stroke="#3a3a44" stroke-width="1"></path>
  <g
    fill="#fff"
    font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    font-size="10.5"
    font-weight="700"
    text-anchor="middle"
    dominant-baseline="central"
  >
    <text x="9.5" y="9.5">M</text>
    <text x="22.5" y="9.5">M</text>
    <text x="9.5" y="22.5">S</text>
    <text x="22.5" y="22.5">P</text>
  </g>
</svg>

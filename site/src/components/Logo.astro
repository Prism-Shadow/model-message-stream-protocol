---
// the four letters in a grid: the mark of the site, the favicon and the artwork
interface Props {
  class?: string;
}
const { class: className = "h-7 w-7" } = Astro.props;
const dark = "fill-[#111116] dark:fill-[#2a2a33]";
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <rect x="1" y="1" width="14" height="14" rx="3.5" fill="#7c4dff"></rect>
  <rect x="17" y="1" width="14" height="14" rx="3.5" class={dark}></rect>
  <rect x="1" y="17" width="14" height="14" rx="3.5" class={dark}></rect>
  <rect x="17" y="17" width="14" height="14" rx="3.5" fill="#7c4dff"></rect>
  <g
    fill="#fff"
    font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    font-size="9.8"
    font-weight="700"
    text-anchor="middle"
    dominant-baseline="central"
  >
    <text x="8" y="8">M</text>
    <text x="24" y="8">M</text>
    <text x="8" y="24">S</text>
    <text x="24" y="24">P</text>
  </g>
</svg>
